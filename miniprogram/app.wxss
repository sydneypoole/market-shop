@import "./components/firstui/fui-theme/fui-theme.wxss";

page {
  /*
   * Taste redesign: cold-luxury neutrals with one plum brand accent.
   * Semantic success/warning/danger colours are reserved for real states.
   */
  --brand-plum: #7A284F;
  --brand-plum-deep: #4B1731;
  --brand-pink: #EADCE4;
  --brand-pink-soft: #F5EBF0;
  --brand-cream: #FAFBFC;
  --brand-canvas: #F3F4F6;
  --brand-ink: #202126;
  --brand-ink-soft: #52545C;
  --brand-muted: #6F656B;
  --brand-line: #E2E4E9;
  --brand-line-strong: #D2D5DC;
  --brand-success: #2D7058;
  --brand-warning: #A3682D;
  --brand-danger: #B73F59;
  --brand-shadow: 0 18rpx 46rpx rgba(32, 33, 38, 0.09);
  --brand-shadow-soft: 0 8rpx 24rpx rgba(32, 33, 38, 0.055);
  --brand-radius-card: 20rpx;
  --brand-radius-control: 16rpx;
  --brand-transition: 180ms cubic-bezier(0.16, 1, 0.3, 1);

  /* FirstUI 公开版主题映射。 */
  --fui-color-primary: var(--brand-plum);
  --fui-color-success: var(--brand-success);
  --fui-color-warning: var(--brand-warning);
  --fui-color-danger: var(--brand-danger);
  --fui-color-purple: var(--brand-plum);
  --fui-color-title: var(--brand-ink);
  --fui-color-section: var(--brand-ink-soft);
  --fui-color-subtitle: var(--brand-muted);
  --fui-color-label: var(--brand-muted);
  --fui-color-minor: #73767F;
  --fui-color-white: #FFFFFF;
  --fui-color-link: var(--brand-plum);
  --fui-bg-color: #FFFFFF;
  --fui-bg-color-grey: var(--brand-canvas);
  --fui-bg-color-content: var(--brand-cream);
  --fui-bg-color-red: rgba(183, 63, 89, 0.08);
  --fui-bg-color-yellow: rgba(163, 104, 45, 0.09);
  --fui-bg-color-purple: rgba(122, 40, 79, 0.07);
  --fui-bg-color-green: rgba(45, 112, 88, 0.08);
  --fui-bg-color-hover: rgba(122, 40, 79, 0.08);
  --fui-bg-color-mask: rgba(37, 26, 32, 0.56);
  --fui-color-border: var(--brand-line);
  --fui-color-shadow: rgba(75, 23, 49, 0.08);
  --fui-opacity-disabled: 0.48;
  --fui-border-radius-sm: 12rpx;
  --fui-border-radius-base: var(--brand-radius-control);
  --fui-border-radius-lg: var(--brand-radius-card);

  /* 旧页面别名保留，让业务样式平滑迁移。 */
  --ink: var(--brand-ink);
  --ink-soft: var(--brand-ink-soft);
  --muted: var(--brand-muted);
  --paper: #FFFFFF;
  --canvas: var(--brand-canvas);
  --line: var(--brand-line);
  --line-strong: var(--brand-line-strong);
  --coral: var(--brand-plum);
  --gold: var(--brand-warning);
  --green: var(--brand-success);
  --sage: #E9F1ED;
  --radius: var(--brand-radius-card);

  min-height: 100%;
  background: var(--brand-canvas);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, image, button, input, textarea, scroll-view, picker {
  box-sizing: border-box;
}

.surface,
.card-surface {
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid var(--brand-line);
  border-radius: var(--brand-radius-card);
  box-shadow: var(--brand-shadow-soft);
}

.btn-primary,
.btn-outline,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
  transition: transform var(--brand-transition), opacity var(--brand-transition), box-shadow var(--brand-transition);
}

.btn-primary {
  background: var(--brand-plum);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(122, 40, 79, 0.18);
}

.btn-outline {
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand-plum);
  border: 2rpx solid var(--brand-line-strong);
}

.btn-ghost {
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
}

.btn-primary:active,
.btn-outline:active,
.btn-ghost:active {
  transform: scale(0.98);
}

.btn-primary::after,
.btn-outline::after,
.btn-ghost::after {
  border: none;
}

.btn-primary[disabled],
.btn-outline[disabled],
.btn-ghost[disabled] {
  box-shadow: none;
  opacity: 0.48;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 999rpx;
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
  font-size: 20rpx;
  line-height: 1;
}

.hairline-t { border-top: 2rpx solid var(--brand-line); }
.hairline-b { border-bottom: 2rpx solid var(--brand-line); }

.price {
  color: var(--brand-plum);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.focus-ring:focus,
button:focus,
input:focus,
textarea:focus {
  outline: 4rpx solid rgba(122, 40, 79, 0.18);
  outline-offset: 2rpx;
}

@media (prefers-reduced-motion: reduce) {
  .btn-primary,
  .btn-outline,
  .btn-ghost {
    transition: none;
  }
}
