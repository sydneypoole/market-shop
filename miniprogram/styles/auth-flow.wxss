.page {
  min-height: 100vh;
  min-height: 100dvh;
  padding: 0 30rpx calc(40rpx + env(safe-area-inset-bottom));
}

.custom-nav {
  display: block;
}

.custom-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
}

.nav-home {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-width: 96px;
  height: 100%;
  min-height: 44px;
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  background: transparent;
  color: var(--brand-plum);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.nav-home::after,
.mode-button::after,
.text-action::after,
.claim-toggle::after {
  border: 0;
}

.nav-home[disabled],
.text-action[disabled],
.claim-toggle[disabled] {
  background: transparent;
  color: var(--brand-muted);
  opacity: 0.48;
}

.nav-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.3;
}

.nav-balance {
  min-width: 96px;
  height: 1rpx;
  flex-shrink: 0;
}

.brand-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  padding: 34rpx 8rpx 38rpx;
}

.brand-copy {
  flex: 1;
  min-width: 0;
}

.brand-name,
.brand-subtitle,
.card-title,
.card-subtitle,
.field-label,
.field-help,
.field-error {
  display: block;
}

.brand-name {
  color: var(--brand-ink);
  font-size: 43rpx;
  font-weight: 720;
  line-height: 1.22;
  letter-spacing: 1rpx;
}

.brand-subtitle {
  max-width: 450rpx;
  margin-top: 12rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.logo-wrap {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  padding: 6rpx;
  border: 2rpx solid rgba(122, 40, 79, 0.1);
  border-radius: var(--brand-radius-card);
  background: var(--paper);
  box-shadow: var(--brand-shadow-soft);
  animation: auth-mark-enter 200ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.brand-logo {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: var(--brand-radius-control);
}

.auth-card {
  padding: 34rpx 30rpx 30rpx;
  box-shadow: none;
  animation: auth-card-enter 220ms 40ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.card-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: var(--brand-radius-control);
  background: var(--brand-pink-soft);
}

.card-copy {
  flex: 1;
  min-width: 0;
}

.card-title {
  color: var(--brand-ink);
  font-size: 35rpx;
  font-weight: 680;
  line-height: 1.25;
}

.card-subtitle {
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.mode-switch {
  display: flex;
  margin-top: 28rpx;
  padding: 6rpx;
  border-radius: var(--brand-radius-control);
  background: var(--brand-canvas);
}

.mode-button {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  border-radius: 12rpx;
  background: transparent;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 88rpx;
  transition: background var(--brand-transition), color var(--brand-transition), transform var(--brand-transition);
}

.mode-button:active {
  transform: scale(0.98);
}

.mode-button--active {
  background: var(--paper);
  color: var(--brand-plum);
  font-weight: 650;
  box-shadow: var(--brand-shadow-soft);
}

.credential-field {
  margin-top: 28rpx;
}

.field-label {
  margin-bottom: 11rpx;
  color: var(--brand-ink-soft);
  font-size: 24rpx;
  font-weight: 650;
}

.credential-input {
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--brand-line-strong);
  border-radius: var(--brand-radius-control);
  background: rgba(255, 255, 255, 0.96);
  color: var(--brand-ink);
  font-size: 27rpx;
  transition: border-color var(--brand-transition), box-shadow var(--brand-transition);
}

.credential-input:focus {
  border-color: var(--brand-plum);
  box-shadow: 0 0 0 6rpx rgba(122, 40, 79, 0.08);
}

.credential-input--error {
  border-color: var(--brand-danger);
}

.credential-placeholder {
  color: #73767F;
}

.field-help {
  margin-top: 11rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.field-error {
  margin-top: 10rpx;
  color: var(--brand-danger);
  font-size: 24rpx;
  line-height: 1.5;
}

.auth-error {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 16rpx 18rpx;
  border-left: 4rpx solid var(--brand-danger);
  background: rgba(183, 63, 89, 0.07);
  color: var(--brand-danger);
  font-size: 24rpx;
  line-height: 1.5;
}

.auth-error fui-icon {
  flex-shrink: 0;
  margin-top: 2rpx;
}

.auth-button {
  width: 100%;
  min-height: 92rpx;
  margin: 30rpx 0 0;
  font-size: 28rpx;
}

.auth-button fui-icon {
  margin-right: 12rpx;
}

.security-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 22rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.security-note fui-icon {
  flex-shrink: 0;
  margin-top: 2rpx;
}

.claim-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  margin: 14rpx 0 0;
  padding: 14rpx 12rpx;
  border: 0;
  background: transparent;
  color: var(--brand-plum);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.auth-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  min-height: 88rpx;
  margin-top: 16rpx;
  border-top: 2rpx solid var(--brand-line);
  color: var(--brand-muted);
  font-size: 24rpx;
}

.text-action {
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  background: transparent;
  color: var(--brand-plum);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 88rpx;
}

@keyframes auth-mark-enter {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes auth-card-enter {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .logo-wrap,
  .auth-card {
    animation: none;
  }

  .mode-button,
  .credential-input {
    transition: none;
  }
}
