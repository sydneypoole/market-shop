.card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid #e2e4e9;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(32, 33, 38, 0.055);
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

.card:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 14rpx rgba(32, 33, 38, 0.05);
}

.cover { width: 100%; height: 320rpx; background: #eef0f3; display: block; }
.cover--placeholder { display: flex; align-items: center; justify-content: center; }
.body { padding: 22rpx 20rpx 26rpx; }
.name {
  display: -webkit-box;
  overflow: hidden;
  min-height: 76rpx;
  color: #202126;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.price-row { display: flex; align-items: baseline; gap: 12rpx; margin-top: 14rpx; }
.price { color: #7a284f; font-size: 32rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.currency { margin-right: 2rpx; font-size: 22rpx; }
.market { color: var(--brand-muted); font-size: 21rpx; text-decoration: line-through; }

@media (prefers-reduced-motion: reduce) {
  .card { transition: none; }
}
