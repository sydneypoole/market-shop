.empty {
  width: 100%;
  padding: 104rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty__mark {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e2e4e9;
  border-radius: 20rpx;
  background: #f5ebf0;
}
.empty__action { width: 280rpx; margin-top: 36rpx; }
