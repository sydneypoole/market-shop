<view class="empty" aria-live="polite">
  <view class="empty__mark" aria-hidden="true">
    <fui-icon name="{{icon || 'goods'}}" size="42" color="#7A284F" disabled aria-hidden="true" />
  </view>
  <fui-empty
    title="{{text || '暂无内容'}}"
    descr="{{hint}}"
    color="#202126"
    descr-color="#6F656B"
    size="32"
    descr-size="24"
  >
    <view wx:if="{{buttonText}}" class="empty__action">
      <fui-button
        text="{{buttonText}}"
        height="88rpx"
        radius="44rpx"
        background="#7A284F"
        color="#FFFFFF"
        size="28"
        bind:click="onAction"
      />
    </view>
  </fui-empty>
</view>
