:host {
  display: block;
  min-height: 100vh;
  min-height: 100dvh;
}

.brand-shell {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;
  background: linear-gradient(180deg, #fafbfc 0, #f3f4f6 360rpx, #f3f4f6 100%);
}

.brand-shell--quiet {
  background: #f3f4f6;
}

.brand-shell--hero {
  background: linear-gradient(180deg, #fafbfc 0, #f3f4f6 480rpx, #f3f4f6 100%);
}

.brand-shell--safe {
  padding-bottom: env(safe-area-inset-bottom);
}

.brand-shell--padded .brand-shell__content {
  padding: 24rpx 28rpx;
}

.brand-shell__content {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;
}

.brand-shell__loading {
  position: fixed;
  z-index: 900;
  left: 50%;
  top: 52%;
  transform: translate(-50%, -50%);
  min-width: 220rpx;
  padding: 20rpx 28rpx;
  border: 2rpx solid #e2e4e9;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 16rpx 42rpx rgba(32, 33, 38, 0.12);
}
