:host {
  display: block;
  min-height: 100vh;
}

.brand-shell {
  position: relative;
  min-height: 100vh;
  background:
    radial-gradient(circle at 102% -4%, rgba(200, 91, 132, 0.13), transparent 34%),
    linear-gradient(180deg, #fff9f7 0, #f8f3f1 360rpx, #f8f3f1 100%);
}

.brand-shell--quiet {
  background: linear-gradient(180deg, #fffcfa, #f8f3f1 420rpx);
}

.brand-shell--hero {
  background:
    radial-gradient(circle at 100% 0, rgba(246, 221, 230, 0.92), transparent 38%),
    linear-gradient(155deg, #fffaf8 0%, #f9edef 52%, #f8f3f1 100%);
}

.brand-shell--safe {
  padding-bottom: env(safe-area-inset-bottom);
}

.brand-shell--padded .brand-shell__content {
  padding: 24rpx 28rpx;
}

.brand-shell__content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

.brand-shell__glow {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  filter: blur(2rpx);
  pointer-events: none;
}

.brand-shell__glow--one {
  top: -132rpx;
  right: 24rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(246, 221, 230, 0.48);
}

.brand-shell__glow--two {
  top: 318rpx;
  left: 0;
  width: 180rpx;
  height: 300rpx;
  background: rgba(122, 40, 79, 0.035);
}

.brand-shell__loading {
  position: fixed;
  z-index: 900;
  left: 50%;
  top: 52%;
  transform: translate(-50%, -50%);
  min-width: 220rpx;
  padding: 20rpx 28rpx;
  border: 2rpx solid rgba(234, 221, 226, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 252, 250, 0.96);
  box-shadow: 0 16rpx 42rpx rgba(75, 23, 49, 0.12);
}
