.sheet { width: 100%; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.head { position: relative; display: flex; padding: 32rpx 32rpx 28rpx; }
.cover {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border: 2rpx solid #e2e4e9;
  border-radius: 20rpx;
  background: #eef0f3;
}
.cover--placeholder { display: flex; align-items: center; justify-content: center; }
.meta { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 7rpx; margin-left: 24rpx; padding-right: 90rpx; }
.price { color: #7a284f; font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.stock, .selected, .qty-hint { color: #6f656b; font-size: 23rpx; }
.selected { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.close {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5ebf0;
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms cubic-bezier(0.16, 1, 0.3, 1);
}
.close:active { transform: scale(0.96); opacity: 0.72; }
.sheet__scroll { max-height: 52vh; }
.section { padding: 26rpx 32rpx 12rpx; }
.label { display: block; margin-bottom: 20rpx; color: #202126; font-size: 27rpx; font-weight: 600; }
.label--inline { margin-bottom: 2rpx; }
.sku-list { display: flex; flex-wrap: wrap; }
.qty-row { display: flex; align-items: center; justify-content: space-between; padding-bottom: 28rpx; }
.footer { padding: 18rpx 32rpx 0; border-top: 2rpx solid #e2e4e9; }
.hairline-b { border-bottom: 2rpx solid #e2e4e9; }

@media (prefers-reduced-motion: reduce) {
  .close { transition: none; }
}
