.sheet { width: 100%; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.head { position: relative; display: flex; padding: 32rpx 32rpx 28rpx; }
.cover {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border: 2rpx solid #eadde2;
  border-radius: 24rpx;
  background: #f8f3f1;
}
.meta { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 7rpx; margin-left: 24rpx; padding-right: 42rpx; }
.eyebrow { color: #7a284f; font-size: 19rpx; font-weight: 600; letter-spacing: 3rpx; }
.price { color: #7a284f; font-size: 40rpx; font-weight: 600; }
.stock, .selected, .qty-hint { color: #8b7881; font-size: 23rpx; }
.selected { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.close {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff0f4;
  color: #7a284f;
  font-size: 38rpx;
  line-height: 50rpx;
  text-align: center;
}
.sheet__scroll { max-height: 52vh; }
.section { padding: 26rpx 32rpx 12rpx; }
.label { display: block; margin-bottom: 20rpx; color: #251a20; font-size: 27rpx; font-weight: 600; }
.label--inline { margin-bottom: 2rpx; }
.sku-list { display: flex; flex-wrap: wrap; }
.qty-row { display: flex; align-items: center; justify-content: space-between; padding-bottom: 28rpx; }
.footer { padding: 18rpx 32rpx 0; border-top: 2rpx solid #eadde2; }
.hairline-b { border-bottom: 2rpx solid #eadde2; }
