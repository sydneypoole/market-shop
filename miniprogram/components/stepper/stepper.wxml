<view class="stepper" aria-label="商品数量，当前 {{value}}">
  <fui-input-number
    value="{{value}}"
    min="{{min < 0 ? 0 : min}}"
    max="{{max < min ? min : max}}"
    width="70"
    height="72"
    radius="12"
    margin="10"
    size="25"
    sign-width="24"
    sign-color="#7A284F"
    color="#202126"
    background-color="#F5EBF0"
    bind:change="onFirstUiChange"
  />
</view>
