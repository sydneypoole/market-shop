<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>

  <empty
    wx:elif="{{error}}"
    text="{{error}}"
    hint="请检查网络后重试"
    buttonText="重新加载"
    bind:action="load"
  />

  <block wx:elif="{{info}}">
    <view class="level-card">
      <text class="level-name serif">{{info.levelName}}</text>
      <view class="tag level-tag">{{info.levelCode}}</view>
    </view>

    <view class="metrics hairline-b">
      <view class="metric">
        <text class="metric-value serif">{{info.availablePoints}}</text>
        <text class="metric-label">可用积分</text>
      </view>
      <view class="metric-divider"></view>
      <view class="metric">
        <text class="metric-value serif">{{info.frozenPoints}}</text>
        <text class="metric-label">冻结积分</text>
      </view>
    </view>

    <view class="stat-row hairline-b">
      <text class="stat-label">直推会员</text>
      <view class="stat-right">
        <text class="stat-value serif">{{info.qualifiedDirectCount}}</text>
        <text class="stat-unit">人</text>
      </view>
    </view>

    <view class="entries">
      <view class="entry-row hairline-b" bindtap="goInvite">
        <text class="entry-label">我的邀请码</text>
        <text class="chevron">›</text>
      </view>
      <view class="entry-row hairline-b" bindtap="goPoints">
        <text class="entry-label">积分流水</text>
        <text class="chevron">›</text>
      </view>
      <view class="entry-row" bindtap="goMembers">
        <text class="entry-label">直推会员</text>
        <text class="chevron">›</text>
      </view>
    </view>
  </block>

  <view wx:else class="state">暂无会员信息</view>
</view>
