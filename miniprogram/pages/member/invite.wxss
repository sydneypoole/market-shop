.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.invite-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--brand-radius-card);
  background: var(--brand-plum-deep);
  box-shadow: 0 22rpx 52rpx rgba(75, 23, 49, 0.25);
}

.invite-card__content {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx 32rpx;
}

.invite-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.invite-kicker,
.invite-title,
.code,
.code-hint,
.stat-label,
.stat-value {
  display: block;
}

.invite-kicker {
  color: rgba(255, 255, 255, 0.7);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.invite-title {
  margin-top: 6rpx;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}

.code-panel {
  margin-top: 30rpx;
  padding: 26rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.17);
  border-radius: var(--brand-radius-control);
  background: rgba(255, 255, 255, 0.11);
  text-align: center;
}

.code {
  overflow-wrap: anywhere;
  color: #FFFFFF;
  font-size: 54rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  line-height: 1.25;
}

.code-hint {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.invite-stats {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.invite-stat {
  flex: 1;
  min-width: 0;
}

.stat-divider {
  width: 2rpx;
  height: 54rpx;
  margin: 0 24rpx;
  background: rgba(255, 255, 255, 0.18);
}

.stat-label {
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.stat-value {
  margin-top: 5rpx;
  color: #FFFFFF;
  font-size: 28rpx;
}

.qr-panel {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: var(--brand-radius-control);
  background: rgba(255, 255, 255, 0.11);
  text-align: center;
}

.qr-brand {
  display: block;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.qr-image {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: 18rpx auto 0;
  background: #FFFFFF;
}

.qr-actions {
  display: flex;
  margin-top: 18rpx;
}

.copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 30rpx 0 0;
  border: none;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--brand-plum);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.copy-button fui-icon { margin-right: 10rpx; }

.copy-button::after,
.secondary-button::after {
  border: none;
}

.secondary-button {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
  line-height: 84rpx;
}

.secondary-button + .secondary-button {
  margin-left: 12rpx;
}

.invite-empty {
  overflow: hidden;
  padding-bottom: 30rpx;
}

.members-section {
  margin-top: 42rpx;
}

.members-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 6rpx 20rpx;
}

.members-title {
  display: block;
  color: var(--brand-ink);
  font-size: 33rpx;
  font-weight: 700;
}

.members-subtitle { display: block; margin-top: 5rpx; color: var(--brand-muted); font-size: 21rpx; }

.member-list {
  overflow: hidden;
  padding: 0 24rpx;
}

.member-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.member-avatar {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: var(--brand-radius-control);
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
}

.member-copy {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
}

.member-name {
  max-width: 380rpx;
  margin-right: 12rpx;
  overflow: hidden;
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-performance,
.member-order {
  display: block;
  margin-top: 7rpx;
  color: var(--brand-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.member-order {
  color: var(--brand-plum);
}

.members-empty {
  overflow: hidden;
}
