.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.member-hero {
  position: relative;
  min-height: 260rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: linear-gradient(145deg, var(--brand-plum-deep), #8e345f);
  box-shadow: 0 20rpx 48rpx rgba(75, 23, 49, 0.24);
}

.hero-orb {
  position: absolute;
  top: -90rpx;
  right: -74rpx;
  width: 270rpx;
  height: 270rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.17);
  border-radius: 50%;
  box-shadow: inset 0 0 0 42rpx rgba(255, 255, 255, 0.035);
}

.member-hero__content {
  position: relative;
  z-index: 1;
  padding: 42rpx 34rpx;
}

.hero-kicker,
.level-name,
.hero-note {
  display: block;
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.level-row {
  display: flex;
  align-items: center;
  margin-top: 13rpx;
}

.level-name {
  margin-right: 18rpx;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 600;
}

.hero-note {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
}

.points-card,
.direct-card {
  margin-top: 22rpx;
  padding: 30rpx 28rpx;
}

.card-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.card-title,
.section-title,
.direct-title {
  display: block;
  margin-top: 5rpx;
  color: var(--brand-ink);
  font-size: 33rpx;
  font-weight: 600;
}

.card-link {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  color: var(--brand-plum);
  font-size: 23rpx;
}

.chevron {
  margin-left: 6rpx;
  color: var(--brand-muted);
  font-size: 34rpx;
  line-height: 1;
}

.metric-grid {
  display: flex;
  margin-top: 28rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--brand-canvas);
}

.metric + .metric {
  margin-left: 16rpx;
}

.metric--primary {
  background: linear-gradient(145deg, var(--brand-pink-soft), #f7e8ed);
}

.metric-label,
.metric-value {
  display: block;
}

.metric-label {
  color: var(--brand-muted);
  font-size: 22rpx;
}

.metric-value {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--brand-plum);
  font-size: 46rpx;
  font-weight: 600;
  text-overflow: ellipsis;
}

.direct-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.direct-copy {
  flex: 1;
  min-width: 0;
  padding-right: 22rpx;
}

.direct-title {
  font-size: 30rpx;
  line-height: 1.4;
}

.direct-note {
  display: block;
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
}

.direct-value {
  display: flex;
  flex-shrink: 0;
  align-items: baseline;
}

.direct-number {
  color: var(--brand-plum);
  font-size: 58rpx;
  font-weight: 600;
}

.direct-unit {
  margin-left: 6rpx;
  color: var(--brand-muted);
  font-size: 22rpx;
}

.action-section {
  margin-top: 40rpx;
}

.section-heading {
  padding: 0 6rpx 20rpx;
}

.action-card {
  overflow: hidden;
  padding: 0 24rpx;
}

.action-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.action-main {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.action-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 19rpx;
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
  font-family: "Songti SC", "STSong", serif;
  font-size: 23rpx;
  font-weight: 600;
}

.action-title,
.action-hint {
  display: block;
}

.action-title {
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 500;
}

.action-hint {
  margin-top: 4rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
}
