.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.state {
  padding: 120rpx 0;
  text-align: center;
  color: var(--muted);
}

.level-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 32rpx 32rpx;
}

.level-name {
  font-size: 44rpx;
  color: var(--ink);
  line-height: 1.3;
}

.level-tag {
  color: var(--muted);
  border-color: var(--line-strong);
}

.metrics {
  display: flex;
  align-items: center;
  padding: 8rpx 32rpx 40rpx;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.metric-divider {
  width: 2rpx;
  height: 72rpx;
  background: var(--line);
}

.metric-value {
  font-size: 56rpx;
  color: var(--ink);
  line-height: 1.2;
}

.metric-label {
  font-size: 24rpx;
  color: var(--muted);
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 32rpx;
}

.stat-label {
  font-size: 28rpx;
  color: var(--ink);
}

.stat-right {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  color: var(--ink);
}

.stat-unit {
  font-size: 24rpx;
  color: var(--muted);
}

.entries {
  margin-top: 24rpx;
  padding: 0 32rpx;
  border-top: 2rpx solid var(--line);
}

.entry-row {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-label {
  font-size: 28rpx;
  color: var(--ink);
}

.chevron {
  color: var(--muted);
  font-size: 32rpx;
  line-height: 1;
}
