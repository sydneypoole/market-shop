.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.ledger-hero {
  display: flex;
  align-items: center;
  min-height: 190rpx;
  padding: 30rpx 28rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.ledger-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border-radius: var(--brand-radius-control);
  background: var(--brand-pink-soft);
}

.ledger-copy {
  flex: 1;
  min-width: 0;
}

.ledger-title,
.ledger-note {
  display: block;
}

.ledger-title {
  color: var(--brand-ink);
  font-size: 35rpx;
  font-weight: 700;
}

.ledger-note {
  margin-top: 7rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 38rpx 6rpx 20rpx;
}

.list-title {
  color: var(--brand-ink);
  font-size: 33rpx;
  font-weight: 700;
}

.ledger-list {
  overflow: hidden;
  padding: 0 24rpx;
}

.entry-row {
  position: relative;
  display: flex;
  min-height: 128rpx;
  align-items: center;
  padding: 22rpx 2rpx;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-title-row {
  display: flex;
  align-items: center;
}

.order-link {
  margin-left: 12rpx;
  color: var(--brand-plum);
  font-size: 19rpx;
}

.entry-time {
  display: block;
  margin-top: 9rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
}

.entry-deltas {
  display: flex;
  flex-shrink: 0;
  align-items: flex-end;
  margin-left: 16rpx;
  flex-direction: column;
}

.delta {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
}

.delta + .delta {
  margin-top: 5rpx;
}

.delta--positive {
  color: var(--brand-success);
}

.delta--negative {
  color: var(--brand-danger);
}

.delta--frozen {
  color: var(--brand-warning);
}

.delta--muted {
  color: var(--brand-muted);
  font-family: inherit;
  font-size: 20rpx;
  font-weight: 400;
}

.entry-row > fui-icon { flex-shrink: 0; margin-left: 9rpx; }

.empty-card {
  margin-top: 4rpx;
  overflow: hidden;
}
