<brand-shell
  loading="{{loading}}"
  loading-text="正在加载邀请信息"
  tone="quiet"
  safe-bottom="{{true}}"
  aria-label="邀请码与直推会员"
>
  <view class="page">
    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      bind:action="load"
    />

    <block wx:elif="{{!loading}}">
      <view wx:if="{{invitation}}" class="invite-card">
        <view class="invite-card__content">
          <view class="invite-head">
            <view>
              <text class="invite-kicker">我的邀请码</text>
              <text class="invite-title">邀请好友注册</text>
            </view>
            <fui-tag
              text="{{invitation.statusText}}"
              background="rgba(255,255,255,0.16)"
              color="#FFFFFF"
              border-color="rgba(255,255,255,0.34)"
              size="19"
              padding="8rpx 14rpx"
              radius="99"
            />
          </view>

          <view
            class="code-panel"
            bindtap="onCopy"
            aria-role="button"
            aria-label="复制邀请码 {{invitation.code}}"
          >
            <text class="code" user-select="{{true}}">{{invitation.code}}</text>
            <text class="code-hint">点击卡片或下方按钮复制</text>
          </view>

          <view class="invite-stats">
            <view class="invite-stat">
              <text class="stat-label">已邀请</text>
              <text class="stat-value">{{invitation.useCount}} 次</text>
            </view>
            <view class="stat-divider"></view>
            <view class="invite-stat">
              <text class="stat-label">邀请码规则</text>
              <text class="stat-value">长期固定</text>
            </view>
          </view>

          <view class="qr-panel">
            <text class="qr-brand">宏杉生物</text>
            <image wx:if="{{qrImage}}" class="qr-image" src="{{qrImage}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
            <view class="qr-actions">
              <button class="secondary-button" bindtap="onSaveCard">保存二维码卡片</button>
              <button class="secondary-button" open-type="share">分享邀请</button>
            </view>
          </view>

          <button
            class="copy-button"
            bindtap="onCopy"
          ><fui-icon name="invite" size="34" color="#7A284F" disabled aria-hidden="true" /><text>复制邀请码</text></button>
        </view>
      </view>

      <view wx:else class="invite-empty surface">
        <empty
          text="固定邀请码暂未就绪"
          hint="请重新加载获取邀请码"
          buttonText="重新加载"
          bind:action="load"
        />
      </view>

      <view class="members-section" id="members">
        <view class="members-head">
          <view>
            <text class="members-title">直推会员</text>
            <text class="members-subtitle">当前邀请关系与业绩状态</text>
          </view>
          <fui-tag
            text="{{members.length}} 人"
            background="#F5EBF0"
            color="#7A284F"
            border-color="#D2D5DC"
            size="20"
            padding="9rpx 16rpx"
            radius="99"
          />
        </view>

        <view wx:if="{{members.length}}" class="member-list surface">
          <view
            class="member-row {{index < members.length - 1 ? 'hairline-b' : ''}}"
            wx:for="{{members}}"
            wx:key="userId"
          >
            <view class="member-avatar" aria-hidden="true"><fui-icon name="my" size="34" color="#7A284F" disabled disabled aria-hidden="true" /></view>
            <view class="member-copy">
              <view class="member-name-row">
                <text class="member-name">{{item.nickname}}</text>
                <fui-tag
                  wx:if="{{item.levelName}}"
                  text="{{item.levelName}}"
                  theme="light"
                  type="purple"
                  size="18"
                  padding="6rpx 12rpx"
                  radius="99"
                />
              </view>
              <text class="member-performance">业绩 ¥{{item.performanceText}} · {{item.performanceStatusText}}</text>
              <text wx:if="{{item.ordinalText}}" class="member-order">{{item.ordinalText}}</text>
            </view>
          </view>
        </view>

        <view wx:else class="members-empty surface">
          <empty text="暂无直推会员" hint="邀请注册后，相关信息会显示在这里" />
        </view>
      </view>
    </block>
  </view>
</brand-shell>
