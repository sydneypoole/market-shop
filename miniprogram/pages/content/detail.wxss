.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.article {
  display: block;
}

.cover-wrap {
  padding: 24rpx 28rpx 0;
}

.cover {
  display: block;
  width: 100%;
  height: 430rpx;
  border: 2rpx solid rgba(234, 221, 226, 0.78);
  border-radius: 36rpx;
  background: var(--brand-canvas);
  box-shadow: var(--brand-shadow);
}

.cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 72% 18%, rgba(255, 255, 255, 0.9), transparent 28%),
    linear-gradient(140deg, var(--brand-pink), #d8b5c1);
}

.cover--empty image {
  width: 230rpx;
  height: 230rpx;
  opacity: 0.42;
}

.article-head {
  position: relative;
  z-index: 2;
  margin: -52rpx 44rpx 0;
  padding: 34rpx 30rpx 36rpx;
}

.title,
.summary {
  display: block;
}

.title {
  margin-top: 20rpx;
  color: var(--brand-ink);
  font-size: 43rpx;
  font-weight: 600;
  line-height: 1.42;
}

.summary {
  margin-top: 18rpx;
  color: var(--brand-muted);
  font-size: 26rpx;
  line-height: 1.72;
}

.article-body {
  margin: 24rpx 28rpx 0;
  padding: 34rpx 30rpx 42rpx;
}

.body-heading {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.body-line {
  flex: 1;
  height: 2rpx;
  margin-left: 18rpx;
  background: linear-gradient(90deg, var(--brand-line-strong), transparent);
}

.rich-text {
  display: block;
  width: 100%;
  overflow-wrap: anywhere;
  color: var(--brand-ink-soft);
  font-size: 28rpx;
  line-height: 1.88;
}

.body-empty {
  padding: 48rpx 0;
  color: var(--brand-muted);
  font-size: 25rpx;
  text-align: center;
}
