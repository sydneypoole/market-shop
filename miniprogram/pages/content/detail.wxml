<brand-shell
  loading="{{loading}}"
  loading-text="正在加载内容"
  tone="quiet"
  safe-bottom="{{true}}"
  aria-label="内容详情"
>
  <view class="page">
    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="{{retryable ? '请检查网络后重试' : '请返回上一页重新选择'}}"
      buttonText="{{retryable ? '重新加载' : ''}}"
      bind:action="loadContent"
    />

    <view wx:elif="{{!loading && content}}" class="article" aria-role="article">
      <view class="cover-wrap">
        <image
          wx:if="{{coverUrl}}"
          class="cover"
          src="{{coverUrl}}"
          mode="aspectFill"
          aria-role="img"
          aria-label="{{content.title}}"
        />
        <view wx:else class="cover cover--empty" aria-hidden="true">
          <image src="/assets/brand/logo.png" mode="aspectFit" />
        </view>
      </view>

      <view class="article-head surface">
        <text class="article-label">品牌内容</text>
        <text class="title">{{content.title}}</text>
        <text wx:if="{{content.summary}}" class="summary">{{content.summary}}</text>
      </view>

      <view class="article-body surface">
        <view class="body-heading">
          <fui-icon name="list" size="32" color="#7A284F" disabled aria-hidden="true" />
          <text>正文</text>
          <view class="body-line"></view>
        </view>
        <rich-text wx:if="{{content.bodyHtml}}" class="rich-text" nodes="{{content.bodyHtml}}"></rich-text>
        <view wx:else class="body-empty">
          <text>暂无更多内容</text>
        </view>
      </view>
    </view>

    <empty wx:elif="{{!loading}}" text="内容不存在或已下线" />
  </view>
</brand-shell>
