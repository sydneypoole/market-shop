<brand-shell
  loading="{{loading || privacyRequesting}}"
  loading-text="{{privacyRequesting ? '正在确认隐私授权' : progressText}}"
  tone="hero"
  aria-label="宏杉生物会员注册"
>
  <view class="page">
    <view class="custom-nav" style="padding-top: {{navigation.statusBarHeight}}px" aria-label="会员注册导航">
      <view class="custom-nav-bar" style="height: {{navigation.navigationBarHeight}}px">
        <button
          class="nav-home"
          style="width: {{navigation.sideWidth}}px"
          disabled="{{loading || privacyRequesting || accountCreated}}"
          bindtap="goHome"
          aria-label="返回商城首页"
        >
          <fui-icon name="home" size="30" color="#7A284F" disabled aria-hidden="true" />
          <text>返回首页</text>
        </button>
        <text class="nav-title">会员注册</text>
        <view class="nav-balance" style="width: {{navigation.sideWidth}}px" aria-hidden="true"></view>
      </view>
    </view>

    <view class="brand-hero">
      <view class="brand-copy">
        <text class="brand-name">加入宏杉生物</text>
      </view>
      <view class="logo-wrap">
        <image
          class="brand-logo"
          src="/assets/brand/logo.png"
          mode="aspectFit"
          aria-role="img"
          aria-label="宏杉生物品牌标志"
        />
      </view>
    </view>

    <view class="auth-card surface">
      <view class="card-head">
        <view class="card-copy">
          <text class="card-title">{{credentialMode === 'claim' ? '认领发起人账号' : '创建会员账号'}}</text>
          <text wx:if="{{credentialMode === 'claim'}}" class="card-subtitle">仅限平台初始发起人使用</text>
        </view>
      </view>

      <view class="profile-setup">
        <view class="profile-heading">
          <view>
            <text class="profile-title">微信资料</text>
            <text class="profile-description">注册成功后同步保存微信昵称与头像</text>
          </view>
          <text class="profile-state">{{accountCreated ? (nicknameSaved ? '头像待上传' : '账号已创建') : (privacyAuthorized ? '可选择' : '待授权')}}</text>
        </view>

        <view class="privacy-actions">
          <checkbox-group class="privacy-check-group" bindchange="onPrivacyAgreementChange">
            <label class="privacy-check">
              <checkbox
                value="accepted"
                checked="{{privacyAgreed}}"
                disabled="{{loading || privacyRequesting || accountCreated}}"
                color="#7A284F"
              />
              <text>我已阅读并同意</text>
            </label>
          </checkbox-group>
          <button
            class="privacy-link"
            disabled="{{loading || privacyRequesting || accountCreated}}"
            bindtap="openPrivacyContract"
          >《用户隐私保护指引》</button>
        </view>
        <text wx:if="{{privacyError}}" class="profile-error" aria-live="assertive">{{privacyError}}</text>

        <view class="wechat-profile-row">
          <button
            class="avatar-picker"
            open-type="chooseAvatar"
            disabled="{{loading || !privacyAgreed || !privacyAuthorized}}"
            bindchooseavatar="onChooseAvatar"
            aria-label="选择微信头像"
          >
            <view class="avatar-preview">
              <image
                wx:if="{{avatarTempPath}}"
                class="avatar-image"
                src="{{avatarTempPath}}"
                mode="aspectFill"
                binderror="onAvatarPreviewError"
                aria-role="img"
                aria-label="已选择的微信头像"
              />
              <text wx:else class="avatar-fallback">{{avatarFallback}}</text>
              <view class="avatar-camera" aria-hidden="true">
                <fui-icon name="camera" size="26" color="#FFFFFF" disabled aria-hidden="true" />
              </view>
            </view>
            <text class="avatar-action">{{avatarTempPath ? '重新选择' : '选择头像'}}</text>
          </button>

          <view class="nickname-field">
            <text class="field-label">微信昵称</text>
            <input
              class="nickname-input {{nicknameError ? 'nickname-input--error' : ''}}"
              type="nickname"
              maxlength="32"
              value="{{nickname}}"
              disabled="{{loading || nicknameSaved || !privacyAgreed || !privacyAuthorized}}"
              placeholder="请选择或输入微信昵称"
              placeholder-class="credential-placeholder"
              bindinput="onNicknameInput"
              aria-label="微信昵称"
            />
            <text wx:if="{{nicknameError}}" class="profile-error" aria-live="assertive">{{nicknameError}}</text>
          </view>
        </view>
        <text wx:if="{{avatarError}}" class="profile-error avatar-error" aria-live="assertive">{{avatarError}}</text>
      </view>

      <view class="credential-field">
        <text class="field-label">{{credentialMode === 'claim' ? '一次性认领密钥' : '邀请码'}}</text>
        <input
          wx:if="{{credentialMode === 'invite'}}"
          class="credential-input {{fieldError ? 'credential-input--error' : ''}}"
          type="text"
          maxlength="64"
          confirm-type="done"
          placeholder="请输入邀请人提供的邀请码"
          placeholder-class="credential-placeholder"
          value="{{inviteCode}}"
          disabled="{{loading || privacyRequesting || accountCreated}}"
          aria-label="邀请码"
          bindinput="onInviteInput"
          bindconfirm="onRegister"
        />
        <input
          wx:else
          class="credential-input {{fieldError ? 'credential-input--error' : ''}}"
          type="text"
          password="{{true}}"
          maxlength="128"
          confirm-type="done"
          placeholder="请输入一次性发起人认领密钥"
          placeholder-class="credential-placeholder"
          value="{{sponsorClaimSecret}}"
          disabled="{{loading || privacyRequesting || accountCreated}}"
          aria-label="一次性发起人认领密钥"
          bindinput="onSponsorClaimInput"
          bindconfirm="onRegister"
        />
        <text wx:if="{{credentialMode === 'claim'}}" class="field-help">该入口仅通过 mode=sponsor 显式打开，密钥不进入链接</text>
        <text wx:if="{{fieldError}}" class="field-error" aria-live="assertive">{{fieldError}}</text>
      </view>

      <view wx:if="{{formError}}" class="auth-error" aria-live="assertive">
        <fui-icon name="info" size="28" color="#B73F59" disabled aria-hidden="true" />
        <text>{{formError}}</text>
      </view>

      <button
        class="btn-primary auth-button"
        loading="{{loading}}"
        disabled="{{loading || privacyRequesting}}"
        bindtap="onRegister"
      >
        <fui-icon wx:if="{{!loading}}" name="wechat" size="36" color="#FFFFFF" disabled aria-hidden="true" />
        <text>{{loading ? progressText : (accountCreated ? (nicknameSaved ? '重试上传微信头像' : '继续保存微信资料') : (credentialMode === 'claim' ? '认领并保存微信资料' : '注册并保存微信资料'))}}</text>
      </button>

      <view class="auth-switch">
        <text>已有会员账号？</text>
        <button class="text-action" disabled="{{loading || privacyRequesting || accountCreated}}" bindtap="goLogin" aria-label="返回会员登录">去登录</button>
      </view>
    </view>
  </view>
</brand-shell>
