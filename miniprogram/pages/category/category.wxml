<brand-shell
  loading="{{loading}}"
  loading-text="正在加载分类"
  tone="quiet"
  safe-bottom="{{true}}"
  aria-label="商品分类"
>
  <view class="page">
    <view
      class="search-control"
      bindtap="onTapSearch"
      aria-role="button"
      aria-label="搜索商品"
    >
      <view class="search-symbol" aria-hidden="true"></view>
      <text class="search-placeholder">搜索商品</text>
      <text class="search-action">搜索</text>
    </view>

    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      bind:action="loadData"
    />

    <block wx:elif="{{!loading}}">
      <view class="category-hero surface">
        <view class="category-hero__copy">
          <text class="section-eyebrow">分类浏览</text>
          <text class="category-title serif">{{activeName || '全部分类'}}</text>
          <text class="category-sub">按分类查看当前上架商品</text>
        </view>
        <fui-tag
          text="{{products.length}} 件"
          background="#FFF0F4"
          color="#7A284F"
          border-color="#EADDE2"
          size="21"
          padding="10rpx 18rpx"
          radius="99"
        />
      </view>

      <scroll-view
        wx:if="{{categories.length}}"
        class="category-scroll"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        aria-label="选择商品分类"
      >
        <view class="category-track">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="category-chip {{activeId == item.id ? 'category-chip--active' : ''}}"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            bindtap="onSelectCategory"
            aria-role="button"
            aria-checked="{{activeId == item.id}}"
          >
            <text>{{item.name}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{products.length}}" class="catalog-grid">
        <view
          wx:for="{{products}}"
          wx:key="productId"
          class="catalog-cell"
          data-id="{{item.productId}}"
          bindtap="onTapProduct"
          aria-role="button"
        >
          <goods-card
            cover="{{item.cover}}"
            name="{{item.name}}"
            priceFen="{{item.priceFen}}"
            marketPriceFen="{{item.marketPriceFen}}"
          />
        </view>
      </view>

      <view wx:else class="catalog-empty surface">
        <empty
          text="{{categories.length ? '该分类暂无商品' : '暂无可展示分类'}}"
          hint="{{categories.length ? '换个分类看看' : '稍后再来看看'}}"
        />
      </view>

      <view wx:if="{{products.length}}" class="end-note">
        <view class="end-line"></view>
        <text>已展示当前分类全部商品</text>
        <view class="end-line"></view>
      </view>
    </block>
  </view>
</brand-shell>
