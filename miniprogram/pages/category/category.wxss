.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 46rpx;
}

.search-control {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(234, 221, 226, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--brand-shadow-soft);
}

.search-symbol {
  position: relative;
  width: 27rpx;
  height: 27rpx;
  margin-right: 18rpx;
  border: 4rpx solid var(--brand-plum);
  border-radius: 50%;
}

.search-symbol::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--brand-plum);
  content: '';
  transform: rotate(45deg);
}

.search-placeholder {
  flex: 1;
  color: var(--brand-muted);
  font-size: 26rpx;
}

.search-action {
  color: var(--brand-plum);
  font-size: 23rpx;
  font-weight: 600;
}

.category-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 190rpx;
  margin-top: 26rpx;
  padding: 30rpx 28rpx;
  background:
    radial-gradient(circle at 96% 0, rgba(246, 221, 230, 0.72), transparent 42%),
    rgba(255, 255, 255, 0.94);
}

.category-hero__copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.category-title,
.category-sub {
  display: block;
}

.category-title {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--brand-ink);
  font-size: 40rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-sub {
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 23rpx;
}

.category-scroll {
  width: calc(100% + 56rpx);
  margin: 24rpx -28rpx 0;
  white-space: nowrap;
}

.category-track {
  display: inline-flex;
  padding: 2rpx 28rpx 12rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--brand-ink-soft);
  font-size: 24rpx;
}

.category-chip--active {
  border-color: var(--brand-plum);
  background: linear-gradient(135deg, var(--brand-plum-deep), var(--brand-plum));
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(122, 40, 79, 0.18);
}

.catalog-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 10rpx -9rpx 0;
}

.catalog-cell {
  width: 50%;
  padding: 0 9rpx 18rpx;
}

.catalog-empty {
  margin-top: 14rpx;
  overflow: hidden;
}

.end-note {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 26rpx 24rpx 0;
  color: var(--brand-muted);
  font-size: 21rpx;
}

.end-line {
  width: 44rpx;
  height: 2rpx;
  margin: 0 14rpx;
  background: var(--brand-line-strong);
}
