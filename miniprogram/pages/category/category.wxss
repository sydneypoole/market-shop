.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

.search-wrap {
  padding: 16rpx 32rpx 16rpx;
  background: var(--paper);
  flex-shrink: 0;
}

.search-box {
  height: 72rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  background: var(--paper);
}

.search-icon {
  color: var(--muted);
  font-size: 28rpx;
}

.search-placeholder {
  color: var(--muted);
  font-size: 26rpx;
}

.body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
}

.rail {
  width: 176rpx;
  height: 100%;
  background: var(--canvas);
  flex-shrink: 0;
}

.rail-item {
  position: relative;
  min-height: 96rpx;
  padding: 28rpx 16rpx 28rpx 24rpx;
  display: flex;
  align-items: center;
}

.rail-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: transparent;
  border-radius: 0;
}

.rail-item.active .rail-indicator {
  background: var(--coral);
}

.rail-label {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.35;
}

.rail-item.active .rail-label {
  color: var(--ink);
  font-weight: 500;
}

.panel {
  flex: 1;
  height: 100%;
  background: var(--paper);
  padding: 16rpx 16rpx 24rpx;
  box-sizing: border-box;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid-item {
  width: 50%;
  padding: 0 8rpx 16rpx;
  box-sizing: border-box;
}

.end-hint {
  padding: 24rpx 0 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
