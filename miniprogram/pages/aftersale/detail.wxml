<view class="page" wx:if="{{!loading && view}}">
  <view class="status-banner">
    <text class="status-title serif">{{statusTitle}}</text>
    <text class="status-hint">{{statusHint}}</text>
  </view>

  <view class="section ship-section" wx:if="{{actions.canReturnShip}}">
    <view class="section-title">填写回寄物流</view>
    <view class="row hairline-b">
      <text class="label">承运商</text>
      <input class="input" placeholder="如：顺丰速运" value="{{carrier}}" data-field="carrier" bindinput="onInput" />
    </view>
    <view class="row">
      <text class="label">物流单号</text>
      <input class="input" placeholder="请填写物流单号" value="{{trackingNo}}" data-field="trackingNo" bindinput="onInput" />
    </view>
    <button class="btn-primary ship-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmitShipment">提交物流</button>
  </view>

  <view class="section proof-section" wx:if="{{actions.canUploadProof || proofCount}}">
    <view class="proof-title">售后凭证</view>
    <view class="proof-sub">支持 JPG / PNG / WebP，最多 {{maxProofFiles}} 张，单张不超过 {{maxProofSizeText}}</view>
    <view wx:if="{{proofError}}" class="proof-error" bindtap="retryProofs">{{proofError}}</view>
    <view class="proof-list">
      <block wx:for="{{proofPreviews}}" wx:key="proofId">
        <image
          wx:if="{{item.url}}"
          class="proof-thumb"
          src="{{item.url}}"
          mode="aspectFill"
          data-url="{{item.url}}"
          bindtap="previewProof"
        />
        <view wx:else class="proof-thumb proof-placeholder">凭证</view>
      </block>
      <view
        wx:if="{{actions.canUploadProof && proofCount < maxProofFiles}}"
        class="proof-add"
        bindtap="onUploadProof"
      >+</view>
    </view>
    <text class="proof-count">已上传 {{proofCount}} 张</text>
  </view>

  <view class="section info-section">
    <view class="info-row">
      <text class="info-label">售后单号</text>
      <text class="info-value">{{view.afterSaleNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">售后类型</text>
      <text class="info-value">{{typeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">申请原因</text>
      <text class="info-value">{{view.reason}}</text>
    </view>
    <view class="info-row" wx:if="{{view.status === 'REJECTED' && view.adminReason}}">
      <text class="info-label">拒绝原因</text>
      <text class="info-value reject">{{view.adminReason}}</text>
    </view>
    <view class="info-row" wx:if="{{view.returnCarrier}}">
      <text class="info-label">回寄物流</text>
      <text class="info-value">{{view.returnCarrier}} {{view.returnTrackingNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">申请时间</text>
      <text class="info-value">{{createdText}}</text>
    </view>
  </view>

  <view class="section address-section" wx:if="{{returnAddress}}">
    <view class="section-title">回寄地址</view>
    <view class="addr-line">
      <text class="addr-name">{{returnAddress.name}}</text>
      <text class="addr-phone">{{returnAddress.phone}}</text>
    </view>
    <text class="addr-detail">{{returnAddress.address}}</text>
  </view>

  <view class="section order-entry" bindtap="goOrder">
    <text class="order-label">查看关联订单</text>
    <text class="order-chevron">›</text>
  </view>

  <view class="section timeline-section">
    <view class="section-title">售后进度</view>
    <view class="timeline">
      <view wx:for="{{timeline}}" wx:key="key" class="tl-item {{item.state}}">
        <view class="tl-dot"></view>
        <view class="tl-body">
          <text class="tl-label">{{item.label}}</text>
          <text wx:if="{{item.time}}" class="tl-time">{{item.time}}</text>
          <text wx:elif="{{item.hint}}" class="tl-hint">{{item.hint}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-space"></view>
  <view class="footer" wx:if="{{actions.canCancel || actions.canConfirmRefund || actions.canConfirmOffline}}">
    <button wx:if="{{actions.canCancel}}" class="btn-outline foot-btn" disabled="{{actionPending}}" bindtap="onCancel">撤销申请</button>
    <button wx:if="{{actions.canConfirmRefund}}" class="btn-primary foot-btn" loading="{{actionPending}}" disabled="{{actionPending}}" bindtap="onConfirmRefund">确认退款到账</button>
    <button wx:if="{{actions.canConfirmOffline}}" class="btn-primary foot-btn" loading="{{actionPending}}" disabled="{{actionPending}}" bindtap="onConfirmOfflineRefund">确认线下退款</button>
  </view>
</view>

<view wx:elif="{{loading}}" class="state">加载中…</view>
<view wx:else class="state error-state">
  <text>{{error || '售后单不存在'}}</text>
  <button class="btn-outline retry-btn" bindtap="loadDetail">重新加载</button>
</view>
