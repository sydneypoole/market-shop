.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 52rpx;
}

.page--with-footer {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.status-card,
.action-card,
.proof-card,
.detail-card,
.order-entry {
  margin-bottom: 18rpx;
}

.status-card {
  padding: 30rpx;
  background: #fff;
}

.status-topline,
.section-head,
.address-line,
.info-row,
.footer {
  display: flex;
  align-items: center;
}

.status-topline,
.section-head,
.info-row {
  justify-content: space-between;
}

.role-note {
  color: var(--brand-muted);
  font-size: 21rpx;
}

.status-title,
.status-hint,
.meta-label,
.meta-value,
.section-title,
.proof-rule,
.info-label,
.info-value,
.address-detail,
.order-entry__eyebrow,
.order-entry__title,
.timeline-label,
.timeline-note {
  display: block;
}

.status-title {
  margin-top: 24rpx;
  color: var(--brand-ink);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.status-hint {
  margin-top: 12rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.status-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(234, 221, 226, 0.84);
}

.status-meta__item {
  flex: 1;
  min-width: 0;
}

.status-meta__item--right {
  text-align: right;
}

.meta-label {
  color: var(--brand-muted);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.meta-value {
  margin-top: 5rpx;
  color: var(--brand-ink-soft);
  font-size: 22rpx;
  word-break: break-all;
}

.action-card,
.proof-card,
.detail-card {
  padding: 28rpx;
}

.section-head {
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-head--proof {
  margin-bottom: 10rpx;
}

.section-title {
  margin-top: 4rpx;
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 650;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  gap: 20rpx;
}

.form-label {
  width: 132rpx;
  flex-shrink: 0;
  color: var(--brand-ink);
  font-size: 25rpx;
  font-weight: 600;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  color: var(--brand-ink);
  font-size: 26rpx;
  line-height: 66rpx;
  text-align: right;
}

.field-placeholder {
  color: #6f656b;
}

.ship-btn {
  width: 100%;
  margin: 24rpx 0 0;
}

.proof-count {
  min-width: 88rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
  font-size: 21rpx;
  text-align: center;
}

.proof-rule {
  color: var(--brand-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.proof-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 72rpx;
  margin: 18rpx 0 0;
  padding: 12rpx 18rpx;
  border: 0;
  border-radius: 18rpx;
  background: var(--brand-pink-soft);
  color: var(--brand-danger);
  font-size: 21rpx;
  line-height: 1.45;
  text-align: left;
}

.proof-error::after {
  border: 0;
}

.proof-error__action {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--brand-plum);
  font-weight: 600;
}

.proof-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.proof-thumb,
.proof-add {
  width: 100%;
  height: 184rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 22rpx;
  background: var(--brand-cream);
}

.proof-placeholder,
.proof-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
  text-align: center;
}

.placeholder-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid var(--brand-line-strong);
  border-radius: 50%;
  color: var(--brand-danger);
  font-weight: 700;
}

.proof-add {
  margin: 0;
  padding: 0;
  border-style: dashed;
  color: var(--brand-plum);
  line-height: 1.2;
}

.proof-add::after {
  border: 0;
}

.proof-add[disabled] {
  opacity: 0.48;
}

.proof-add__mark {
  font-size: 38rpx;
  font-weight: 300;
}

.proof-add__text {
  font-size: 20rpx;
}

.info-row {
  align-items: flex-start;
  gap: 24rpx;
  min-height: 62rpx;
  padding: 13rpx 0;
  border-bottom: 2rpx solid rgba(234, 221, 226, 0.75);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex-shrink: 0;
  color: var(--brand-muted);
  font-size: 24rpx;
}

.info-value {
  max-width: 72%;
  color: var(--brand-ink-soft);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.info-value--danger {
  color: var(--brand-danger);
}

.address-line {
  gap: 14rpx;
}

.address-name {
  color: var(--brand-ink);
  font-size: 29rpx;
  font-weight: 650;
}

.address-phone {
  color: var(--brand-ink-soft);
  font-size: 24rpx;
}

.address-detail {
  margin-top: 12rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.order-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 112rpx;
  padding: 22rpx 28rpx;
  color: var(--brand-ink);
  line-height: 1.4;
  text-align: left;
}

.order-entry::after {
  border: 0;
}

.order-entry__eyebrow {
  color: var(--brand-plum);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.order-entry__title {
  margin-top: 5rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.order-entry__chevron {
  color: var(--brand-plum);
  font-size: 40rpx;
}

.timeline-item {
  display: flex;
  min-height: 78rpx;
}

.timeline-item:last-child {
  min-height: auto;
}

.timeline-rail {
  position: relative;
  width: 34rpx;
  flex-shrink: 0;
}

.timeline-rail::after {
  position: absolute;
  top: 24rpx;
  bottom: -2rpx;
  left: 10rpx;
  width: 2rpx;
  background: var(--brand-line);
  content: '';
}

.timeline-item:last-child .timeline-rail::after {
  display: none;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  width: 22rpx;
  height: 22rpx;
  margin-top: 6rpx;
  border: 5rpx solid #fff;
  border-radius: 50%;
  background: var(--brand-line-strong);
  box-shadow: 0 0 0 2rpx var(--brand-line);
}

.timeline-item--done .timeline-dot {
  background: var(--brand-success);
  box-shadow: 0 0 0 2rpx rgba(45, 112, 88, 0.22);
}

.timeline-item--current .timeline-dot {
  background: var(--brand-plum);
  box-shadow: 0 0 0 3rpx rgba(122, 40, 79, 0.16);
}

.timeline-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 22rpx;
}

.timeline-label {
  color: var(--brand-muted);
  font-size: 25rpx;
}

.timeline-item--done .timeline-label,
.timeline-item--current .timeline-label {
  color: var(--brand-ink);
  font-weight: 600;
}

.timeline-note {
  margin-top: 4rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
}

.timeline-note--current {
  color: var(--brand-plum);
}

.footer {
  position: fixed;
  z-index: 60;
  right: 0;
  bottom: 0;
  left: 0;
  justify-content: flex-end;
  gap: 14rpx;
  padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(234, 221, 226, 0.9);
  background: rgba(255, 252, 250, 0.97);
  box-shadow: 0 -14rpx 34rpx rgba(75, 23, 49, 0.07);
}

.footer-btn {
  min-width: 210rpx;
  margin: 0;
  font-size: 26rpx;
}

.footer-btn--primary {
  flex: 1;
  max-width: 430rpx;
}

/* Taste redesign: keep progress, evidence and actions in a calm single column. */
.page { padding:28rpx 28rpx 52rpx; }
.status-card,.action-card,.proof-card,.detail-card,.order-entry { margin-bottom:16rpx; border-color:var(--brand-line); box-shadow:none; }
.status-card { padding:28rpx 26rpx; background:#fff; }
.status-title { margin-top:20rpx; font-family:inherit; font-size:44rpx; font-weight:700; letter-spacing:-1rpx; }
.status-meta { border-color:var(--brand-line); }
.action-card,.proof-card,.detail-card { padding:26rpx 24rpx; }
.section-head { margin-bottom:18rpx; }
.section-title { margin-top:0; font-size:29rpx; }
.form-row { display:block; min-height:112rpx; padding:16rpx 0; }
.form-label { width:auto; font-size:23rpx; }
.form-input { width:100%; height:68rpx; margin-top:4rpx; line-height:68rpx; text-align:left; }
.ship-btn { min-height:88rpx; }
.proof-count { background:transparent; color:var(--brand-muted); }
.proof-error { min-height:88rpx; border-left:4rpx solid var(--brand-danger); border-radius:var(--brand-radius-control); background:#fff; }
.proof-thumb,.proof-add { border-radius:var(--brand-radius-control); background:var(--brand-canvas); }
.proof-add { min-height:184rpx; }
.order-entry { min-height:104rpx; padding:20rpx 24rpx; }
.timeline-dot { box-shadow:none; }
.footer { border-color:var(--brand-line); background:rgba(255,255,255,.98); box-shadow:0 -8rpx 24rpx rgba(32,33,38,.05); }
.footer-btn { min-height:88rpx; white-space:nowrap; }
