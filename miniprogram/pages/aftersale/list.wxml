<view class="page">
  <scroll-view class="tabs" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state">加载中…</view>

  <block wx:elif="{{displayList.length}}">
    <view
      wx:for="{{displayList}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="card-head">
        <text class="aftersale-no">售后单 {{item.afterSaleNo}}</text>
        <text class="status tone-{{item.tone}}">{{item.statusText}}</text>
      </view>
      <view class="card-body">
        <text class="type">{{item.typeText}}</text>
        <text class="time">{{item.createdText}}</text>
      </view>
    </view>
  </block>

  <empty wx:else text="{{emptyText}}" hint="{{emptyHint}}" />
</view>
