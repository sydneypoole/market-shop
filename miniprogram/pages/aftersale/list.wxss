.page {
  min-height: 100vh;
  padding: 36rpx 24rpx 52rpx;
}

.page-intro {
  padding: 10rpx 12rpx 26rpx;
}

.page-title,
.page-subtitle,
.card-eyebrow,
.aftersale-no,
.type-label,
.type-value,
.time {
  display: block;
}

.page-title {
  margin-top: 10rpx;
  color: var(--brand-ink);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
}

.tabs-wrap {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tabs {
  display: inline-flex;
  min-width: 100%;
  padding: 6rpx;
  border: 2rpx solid rgba(234, 221, 226, 0.88);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: var(--brand-shadow-soft);
}

.tab {
  min-width: 180rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: var(--brand-muted);
  font-size: 25rpx;
  line-height: 72rpx;
}

.tab::after {
  border: 0;
}

.tab--active {
  background: linear-gradient(135deg, var(--brand-plum-deep), var(--brand-plum));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(122, 40, 79, 0.18);
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  padding: 28rpx;
}

.record-card:active {
  border-color: rgba(122, 40, 79, 0.34);
}

.card-head,
.card-body,
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-identity {
  flex: 1;
  min-width: 0;
}

.card-eyebrow {
  color: var(--brand-plum);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.aftersale-no {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--brand-ink-soft);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-body {
  align-items: flex-end;
  margin-top: 24rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid rgba(234, 221, 226, 0.74);
}

.type-block {
  flex: 1;
  min-width: 0;
}

.type-label {
  color: var(--brand-muted);
  font-size: 20rpx;
}

.type-value {
  margin-top: 4rpx;
  color: var(--brand-ink);
  font-size: 31rpx;
  font-weight: 600;
}

.time {
  flex-shrink: 0;
  color: var(--brand-muted);
  font-size: 21rpx;
}

.card-foot {
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(234, 221, 226, 0.74);
}

.detail-label {
  color: var(--brand-muted);
  font-size: 22rpx;
}

.detail-chevron {
  color: var(--brand-plum);
  font-size: 34rpx;
  line-height: 1;
}
