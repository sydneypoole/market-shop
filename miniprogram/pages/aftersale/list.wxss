.page { min-height:100vh; padding:32rpx 28rpx 52rpx; }
.page-intro { padding:4rpx 0 26rpx; }
.page-title,.page-subtitle,.card-eyebrow,.aftersale-no,.type-label,.type-value,.time { display:block; }
.page-title { color:var(--brand-ink); font-size:44rpx; font-weight:700; line-height:1.2; letter-spacing:-1rpx; }
.page-subtitle { margin-top:10rpx; color:var(--brand-muted); font-size:23rpx; }
.tabs-wrap { width:100%; margin-bottom:22rpx; white-space:nowrap; }
.tabs { display:inline-flex; min-width:100%; gap:4rpx; padding:4rpx; border:2rpx solid var(--brand-line); border-radius:999rpx; background:#fff; }
.tab { min-width:180rpx; min-height:88rpx; margin:0; padding:0 28rpx; border:0; border-radius:999rpx; background:transparent; color:var(--brand-muted); font-size:24rpx; line-height:88rpx; }
.tab::after { border:0; }
.tab--active { background:var(--brand-plum); color:#fff; font-weight:650; }
.record-list { overflow:hidden; border:2rpx solid var(--brand-line); border-radius:var(--brand-radius-card); background:#fff; }
.record-card { padding:26rpx 24rpx; border:0; border-bottom:2rpx solid var(--brand-line); border-radius:0; box-shadow:none; }
.record-card:last-child { border-bottom:0; }
.record-card:active { background:rgba(122,40,79,.025); }
.card-head,.card-body,.card-foot { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.card-identity { flex:1; min-width:0; }
.card-eyebrow { color:var(--brand-muted); font-size:19rpx; }
.aftersale-no { margin-top:4rpx; overflow:hidden; color:var(--brand-ink-soft); font-size:22rpx; font-variant-numeric:tabular-nums; text-overflow:ellipsis; white-space:nowrap; }
.card-body { align-items:flex-end; padding:22rpx 0; }
.type-block { flex:1; min-width:0; }
.type-label { color:var(--brand-muted); font-size:19rpx; }
.type-value { margin-top:3rpx; color:var(--brand-ink); font-size:31rpx; font-weight:650; }
.time { flex-shrink:0; color:var(--brand-muted); font-size:21rpx; }
.card-foot { min-height:88rpx; padding-top:12rpx; border-top:2rpx solid var(--brand-line); }
.detail-label { color:var(--brand-muted); font-size:22rpx; }
.detail-chevron { flex-shrink:0; }
