.page { min-height:100vh; padding:32rpx 28rpx calc(52rpx + env(safe-area-inset-bottom)); }
.page-intro { padding:4rpx 0 28rpx; }
.page-title,.page-subtitle,.notice-title,.notice-text,.card-eyebrow,.order-no,.amount-label,.price,.section-index,.section-title,.section-note,.type-label,.type-desc,.field-label,.submit-hint { display:block; }
.page-title { margin-top:10rpx; color:var(--brand-ink); font-size:44rpx; font-weight:700; line-height:1.2; letter-spacing:-1rpx; }
.page-subtitle { margin-top:10rpx; color:var(--brand-muted); font-size:23rpx; }
.notice-card { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:18rpx; padding:20rpx 22rpx; border-left:4rpx solid var(--brand-danger); background:#fff; }
.notice-copy { flex:1; min-width:0; }
.notice-title { color:var(--brand-danger); font-size:24rpx; font-weight:650; }
.notice-text { margin-top:4rpx; color:var(--brand-ink-soft); font-size:21rpx; line-height:1.5; }
.retry-link { min-width:120rpx; min-height:88rpx; margin:0; padding:0 18rpx; border:0; background:transparent; color:var(--brand-plum); font-size:22rpx; line-height:88rpx; }
.retry-link::after { border:0; }
.order-card { display:flex; align-items:flex-end; justify-content:space-between; gap:20rpx; margin-bottom:18rpx; padding:24rpx; box-shadow:none; }
.order-card__copy { flex:1; min-width:0; }
.card-eyebrow,.amount-label { color:var(--brand-muted); font-size:19rpx; }
.order-no { margin-top:4rpx; overflow:hidden; color:var(--brand-ink-soft); font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }
.order-card__amount { flex-shrink:0; text-align:right; }
.price { margin-top:3rpx; color:var(--brand-plum); font-size:33rpx; font-weight:720; font-variant-numeric:tabular-nums; }
.section-card { margin-bottom:18rpx; padding:26rpx 24rpx; box-shadow:none; }
.section-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; margin-bottom:18rpx; }
.section-index { color:var(--brand-plum); font-size:18rpx; font-weight:700; font-variant-numeric:tabular-nums; }
.section-title { margin-top:3rpx; color:var(--brand-ink); font-size:29rpx; font-weight:650; }
.section-note { color:var(--brand-muted); font-size:20rpx; }
.type-list { border-top:2rpx solid var(--brand-line); }
.type-card { display:flex; align-items:center; gap:16rpx; min-height:106rpx; padding:18rpx 0; border-bottom:2rpx solid var(--brand-line); }
.type-card:last-child { border-bottom:0; }
.type-card--selected { background:rgba(122,40,79,.025); }
.type-mark { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; flex-shrink:0; }
.type-copy { flex:1; min-width:0; }
.type-label { color:var(--brand-ink); font-size:25rpx; font-weight:650; }
.type-desc { margin-top:4rpx; color:var(--brand-muted); font-size:21rpx; line-height:1.45; }
.form-field { min-height:108rpx; padding:18rpx 0; }
.form-field--stack { min-height:0; }
.field-label { color:var(--brand-ink); font-size:24rpx; font-weight:650; }
.field-input { width:100%; height:72rpx; margin-top:6rpx; color:var(--brand-ink); font-size:25rpx; line-height:88rpx; }
.field-textarea { width:100%; min-height:190rpx; margin-top:12rpx; padding:18rpx; border:2rpx solid var(--brand-line); border-radius:var(--brand-radius-control); background:var(--brand-canvas); color:var(--brand-ink); font-size:25rpx; line-height:1.55; }
.field-placeholder { color:#8A8D96; }
.submit-wrap { margin-top:24rpx; }
.submit-btn { width:100%; min-height:88rpx; margin:0; }
.submit-hint { margin-top:10rpx; color:var(--brand-muted); font-size:19rpx; text-align:center; }
