.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  min-height: 196rpx;
  padding: 30rpx 26rpx;
  background:
    radial-gradient(circle at 96% 0, rgba(246, 221, 230, 0.82), transparent 42%),
    rgba(255, 255, 255, 0.94);
}

.avatar-wrap {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  padding: 6rpx;
  overflow: hidden;
  border: 2rpx solid rgba(122, 40, 79, 0.09);
  border-radius: 34rpx;
  background: #FFFFFF;
  box-shadow: var(--brand-shadow-soft);
}

.brand-logo {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin: 0 18rpx 0 22rpx;
}

.profile-kicker,
.nickname,
.public-id {
  display: block;
}

.profile-kicker {
  color: var(--brand-plum);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nickname {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--brand-ink);
  font-size: 36rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.public-id {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--brand-muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card {
  margin-top: 22rpx;
  padding: 30rpx 24rpx 26rpx;
}

.card-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
}

.card-title,
.section-title {
  display: block;
  margin-top: 4rpx;
  color: var(--brand-ink);
  font-size: 33rpx;
  font-weight: 600;
}

.card-link {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  color: var(--brand-plum);
  font-size: 23rpx;
}

.chevron {
  margin-left: 6rpx;
  color: var(--brand-muted);
  font-size: 34rpx;
  line-height: 1;
}

.order-grid {
  display: flex;
  margin-top: 28rpx;
}

.order-entry {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--brand-ink-soft);
  font-size: 22rpx;
}

.entry-mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 11rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 22rpx;
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  font-weight: 600;
}

.service-section {
  margin-top: 40rpx;
}

.section-heading {
  padding: 0 6rpx 20rpx;
}

.service-card {
  overflow: hidden;
  padding: 0 24rpx;
}

.service-row {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 17rpx 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
  text-align: left;
}

.service-main {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.service-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 19rpx;
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
  font-family: "Songti SC", "STSong", serif;
  font-size: 23rpx;
  font-weight: 600;
}

.service-label,
.service-hint {
  display: block;
}

.service-label {
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 500;
}

.service-hint {
  margin-top: 4rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
  line-height: 1.4;
}

.service-right {
  display: flex;
  flex-shrink: 0;
  align-items: center;
}

.contact-row::after {
  border: none;
}

.logout-button {
  width: 100%;
  min-height: 88rpx;
  margin: 28rpx 0 0;
  border: 2rpx solid var(--brand-line-strong);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: var(--brand-plum);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.logout-button::after {
  border: none;
}

.logout-note {
  display: block;
  margin-top: 14rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}
