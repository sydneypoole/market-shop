.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 32rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--sage);
  color: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.user-meta {
  margin-left: 24rpx;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 34rpx;
  color: var(--ink);
  font-weight: 500;
  line-height: 1.3;
}

.member-tag {
  margin-top: 12rpx;
  color: var(--muted);
  border-color: var(--line-strong);
}

.block {
  margin: 8rpx 0 0;
}

.order-block {
  border-top: 16rpx solid var(--canvas);
  border-bottom: 16rpx solid var(--canvas);
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.block-title {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
}

.block-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.order-entries {
  display: flex;
  padding: 16rpx 0 32rpx;
}

.order-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.entry-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-soft);
  line-height: 1;
}

.entry-label {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.service-block {
  padding: 0 32rpx;
}

.service-row {
  width: 100%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-row {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  line-height: normal;
  text-align: left;
}

.contact-row::after {
  border: none;
}

.service-label {
  font-size: 28rpx;
  color: var(--ink);
}

.service-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--coral);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.chevron {
  color: var(--muted);
  font-size: 32rpx;
  line-height: 1;
}

.footer {
  margin-top: 48rpx;
  padding: 0 48rpx;
}

.logout-btn {
  height: 88rpx;
  margin: 32rpx 32rpx 0;
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius);
  background: var(--paper);
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 84rpx;
}

.logout-btn::after {
  border: none;
}

.footer-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
