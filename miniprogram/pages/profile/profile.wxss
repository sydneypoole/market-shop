.page {
  min-height: 100vh;
  min-height: 100dvh;
  padding: 24rpx 32rpx 48rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  min-height: 196rpx;
  padding: 30rpx 26rpx;
  background: rgba(255, 255, 255, 0.98);
}

.avatar-wrap {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(122, 40, 79, 0.09);
  border-radius: 50%;
  background: var(--brand-pink-soft);
}

.member-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-fallback {
  color: var(--brand-plum);
  font-size: 42rpx;
  font-weight: 700;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin: 0 18rpx 0 22rpx;
}

.profile-kicker,
.nickname,
.public-id,
.phone-masked {
  display: block;
}

.profile-kicker {
  color: var(--brand-plum);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.nickname {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--brand-ink);
  font-size: 36rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.public-id {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--brand-muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-masked {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--brand-muted);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card {
  margin-top: 22rpx;
  padding: 30rpx 24rpx 26rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.card-title,
.section-title {
  display: block;
  color: var(--brand-ink);
  font-size: 31rpx;
  font-weight: 600;
}

.card-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--brand-plum);
  font-size: 23rpx;
}

.chevron {
  display: flex;
  width: 30rpx;
  height: 40rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.order-grid {
  display: flex;
  margin-top: 28rpx;
}

.order-entry {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--brand-ink-soft);
  font-size: 22rpx;
  transition: transform var(--brand-transition), opacity var(--brand-transition);
}

.order-entry:active {
  transform: scale(0.97);
  opacity: 0.76;
}

.entry-mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 11rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 16rpx;
  background: var(--brand-pink-soft);
}

.service-section {
  margin-top: 32rpx;
}

.section-heading {
  padding: 0 4rpx 16rpx;
}

.service-card {
  overflow: hidden;
  padding: 0 24rpx;
  box-shadow: none;
}

.service-row {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 17rpx 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
  text-align: left;
  transition: background-color var(--brand-transition), opacity var(--brand-transition);
}

.service-row:active {
  background: rgba(122, 40, 79, 0.045);
  opacity: 0.8;
}

.service-main {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.service-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 14rpx;
  background: var(--brand-pink-soft);
}

.service-label,
.service-hint {
  display: block;
}

.service-label {
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 500;
}

.service-hint {
  margin-top: 4rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
  line-height: 1.4;
}

.service-right {
  display: flex;
  flex-shrink: 0;
  align-items: center;
}

.contact-row::after {
  border: none;
}

.logout-button {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 28rpx 0 0;
  padding: 0 28rpx;
  border: 2rpx solid var(--brand-line-strong);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: var(--brand-plum);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  transition: transform var(--brand-transition), opacity var(--brand-transition);
}

.logout-button:active {
  transform: scale(0.98);
}

.logout-icon {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
}

.logout-button::after {
  border: none;
}

.logout-note {
  display: block;
  margin-top: 14rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .order-entry,
  .service-row,
  .logout-button {
    transition: none;
  }
}
