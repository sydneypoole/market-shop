<brand-shell
  loading="{{loading || loggingOut}}"
  loading-text="{{loggingOut ? '正在退出' : '正在加载账号'}}"
  tone="hero"
  safe-bottom="{{true}}"
  aria-label="我的账号"
>
  <view class="page">
    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      bind:action="loadProfile"
    />

    <block wx:elif="{{!loading}}">
    <view class="profile-hero surface">
      <view class="avatar-wrap">
        <image
          class="brand-logo"
          src="/assets/brand/logo.png"
          mode="aspectFit"
          aria-role="img"
          aria-label="宏杉生物品牌标志"
        />
      </view>
      <view class="profile-copy">
        <text class="profile-kicker">宏杉生物会员</text>
        <text class="nickname serif">{{nickname || '宏杉会员'}}</text>
        <text wx:if="{{publicId}}" class="public-id">会员编号 {{publicId}}</text>
      </view>
      <fui-tag
        text="{{levelName || '会员'}}"
        background="#FFF0F4"
        color="#7A284F"
        border-color="#EADDE2"
        size="20"
        padding="9rpx 16rpx"
        radius="99"
      />
    </view>

    <view class="order-card surface">
      <view class="card-head">
        <view>
          <text class="section-eyebrow">订单中心</text>
          <text class="card-title serif">我的订单</text>
        </view>
        <view
          class="card-link"
          bindtap="goAllOrders"
          aria-role="button"
          aria-label="查看全部订单"
        >
          <text>全部订单</text>
          <text class="chevron" aria-hidden="true">›</text>
        </view>
      </view>

      <view class="order-grid">
        <!-- order/list tabs: 0全部 1待确认 2待发货 3待收货 4已完成 -->
        <view
          class="order-entry"
          data-tab="1"
          bindtap="goOrderTab"
          aria-role="button"
          aria-label="待确认订单"
        >
          <view class="entry-mark" aria-hidden="true">确</view>
          <text>待确认</text>
        </view>
        <view
          class="order-entry"
          data-tab="2"
          bindtap="goOrderTab"
          aria-role="button"
          aria-label="待发货订单"
        >
          <view class="entry-mark" aria-hidden="true">发</view>
          <text>待发货</text>
        </view>
        <view
          class="order-entry"
          data-tab="3"
          bindtap="goOrderTab"
          aria-role="button"
          aria-label="待收货订单"
        >
          <view class="entry-mark" aria-hidden="true">收</view>
          <text>待收货</text>
        </view>
        <view
          class="order-entry"
          bindtap="goAftersaleList"
          aria-role="button"
          aria-label="查看退款售后"
        >
          <view class="entry-mark" aria-hidden="true">售</view>
          <text>退款售后</text>
        </view>
      </view>
    </view>

    <view class="service-section">
      <view class="section-heading">
        <text class="section-eyebrow">会员服务</text>
        <text class="section-title serif">常用入口</text>
      </view>

      <view class="service-card surface">
        <view class="service-row hairline-b" bindtap="goMemberCenter" aria-role="button">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">会</view>
            <view>
              <text class="service-label">会员中心</text>
              <text class="service-hint">查看等级、积分与直推信息</text>
            </view>
          </view>
          <text class="chevron" aria-hidden="true">›</text>
        </view>

        <view class="service-row hairline-b" bindtap="goNotify" aria-role="button">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">消</view>
            <view>
              <text class="service-label">消息通知</text>
              <text class="service-hint">查看订单与售后通知</text>
            </view>
          </view>
          <view class="service-right">
            <fui-badge
              wx:if="{{unreadCount > 0}}"
              value="{{unreadCount}}"
              max="99"
              background="#B73F59"
            />
            <text class="chevron" aria-hidden="true">›</text>
          </view>
        </view>

        <view class="service-row hairline-b" bindtap="goAddress" aria-role="button">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">地</view>
            <view>
              <text class="service-label">收货地址</text>
              <text class="service-hint">管理订单收货信息</text>
            </view>
          </view>
          <text class="chevron" aria-hidden="true">›</text>
        </view>

        <view class="service-row hairline-b" bindtap="goAftersaleList" aria-role="button">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">售</view>
            <view>
              <text class="service-label">退款售后</text>
              <text class="service-hint">查看申请与处理进度</text>
            </view>
          </view>
          <text class="chevron" aria-hidden="true">›</text>
        </view>

        <view class="service-row hairline-b" bindtap="goSuperiorOrders" aria-role="button">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">审</view>
            <view>
              <text class="service-label">上级待确认订单</text>
              <text class="service-hint">查看需要你确认的订单</text>
            </view>
          </view>
          <text class="chevron" aria-hidden="true">›</text>
        </view>

        <view class="service-row hairline-b" bindtap="goRules" aria-role="button">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">规</view>
            <view>
              <text class="service-label">规则说明</text>
              <text class="service-hint">查看当前生效的规则配置</text>
            </view>
          </view>
          <text class="chevron" aria-hidden="true">›</text>
        </view>

        <button
          class="service-row contact-row hairline-b"
          open-type="contact"
          hover-class="none"
          aria-label="联系客服"
        >
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">客</view>
            <view>
              <text class="service-label">联系客服</text>
              <text class="service-hint">使用微信客服能力发起咨询</text>
            </view>
          </view>
          <text class="chevron" aria-hidden="true">›</text>
        </button>

        <view class="service-row" bindtap="onAbout" aria-role="button">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">关</view>
            <view>
              <text class="service-label">关于宏杉生物</text>
              <text class="service-hint">查看平台信息</text>
            </view>
          </view>
          <text class="chevron" aria-hidden="true">›</text>
        </view>
      </view>
    </view>

    <button
      class="logout-button"
      loading="{{loggingOut}}"
      disabled="{{loggingOut}}"
      bindtap="onLogout"
    >{{loggingOut ? '正在退出…' : '退出登录'}}</button>
    <text class="logout-note">退出后，再次使用需重新完成微信登录</text>
    </block>
  </view>
</brand-shell>
