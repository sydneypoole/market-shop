<view class="page">
  <view class="user-card">
    <view class="avatar serif">拾</view>
    <view class="user-meta">
      <text class="nickname">{{nickname || '拾光会员'}}</text>
      <view class="tag member-tag">{{levelName || '会员'}}</view>
    </view>
  </view>

  <view class="block order-block">
    <view class="block-head hairline-b">
      <text class="block-title">我的订单</text>
      <view class="block-link" bindtap="goAllOrders">
        <text>全部订单</text>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="order-entries">
      <!-- order/list tabs: 0全部 1待确认 2待发货 3待收货 4已完成 -->
      <view class="order-entry" data-tab="1" bindtap="goOrderTab">
        <view class="entry-icon serif">☰</view>
        <text class="entry-label">待确认</text>
      </view>
      <view class="order-entry" data-tab="2" bindtap="goOrderTab">
        <view class="entry-icon">▣</view>
        <text class="entry-label">待发货</text>
      </view>
      <view class="order-entry" data-tab="3" bindtap="goOrderTab">
        <view class="entry-icon">🚚</view>
        <text class="entry-label">待收货</text>
      </view>
      <view class="order-entry" bindtap="goAftersaleList">
        <view class="entry-icon">↩</view>
        <text class="entry-label">退款/售后</text>
      </view>
    </view>
  </view>

  <view class="block service-block">
    <view class="service-row hairline-b" bindtap="goMemberCenter">
      <text class="service-label">会员中心</text>
      <text class="chevron">›</text>
    </view>
    <view class="service-row hairline-b" bindtap="goNotify">
      <text class="service-label">消息通知</text>
      <view class="service-right">
        <text wx:if="{{unreadCount > 0}}" class="badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="service-row hairline-b" bindtap="goAddress">
      <text class="service-label">收货地址</text>
      <text class="chevron">›</text>
    </view>
    <view class="service-row hairline-b" bindtap="goAftersaleList">
      <text class="service-label">退款/售后</text>
      <text class="chevron">›</text>
    </view>
    <view class="service-row hairline-b" bindtap="goSuperiorOrders">
      <text class="service-label">上级待确认订单</text>
      <text class="chevron">›</text>
    </view>
    <view class="service-row hairline-b" bindtap="goRules">
      <text class="service-label">规则说明</text>
      <text class="chevron">›</text>
    </view>
    <button class="service-row contact-row hairline-b" open-type="contact" hover-class="none">
      <text class="service-label">联系客服</text>
      <text class="chevron">›</text>
    </button>
    <view class="service-row" bindtap="onAbout">
      <text class="service-label">关于拾光优选</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <button
    class="logout-btn"
    loading="{{loggingOut}}"
    disabled="{{loggingOut}}"
    bindtap="onLogout"
  >退出登录</button>

  <view class="footer">
    <text class="footer-text">积分不可提现、不可转让、不可兑换现金 · 奖励关系仅直属一层</text>
  </view>
</view>
