<brand-shell
  loading="{{loading || loggingOut}}"
  loading-text="{{loggingOut ? '正在退出' : '正在加载账号'}}"
  tone="hero"
  safe-bottom="{{true}}"
  aria-label="我的账号"
>
  <view class="page">
    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      icon="nonetwork"
      bind:action="loadProfile"
    />

    <block wx:elif="{{!loading}}">
    <view class="profile-hero surface">
      <view class="avatar-wrap">
        <image
          wx:if="{{avatarUrl && !avatarFailed}}"
          class="member-avatar"
          src="{{avatarUrl}}"
          mode="aspectFill"
          binderror="onAvatarError"
          aria-role="img"
          aria-label="{{nickname || '会员'}}的会员头像"
        />
        <text wx:else class="avatar-fallback" aria-label="会员头像占位">{{avatarFallback}}</text>
      </view>
      <view class="profile-copy">
        <text class="profile-kicker">宏杉生物会员</text>
        <text class="nickname">{{nickname || '宏杉会员'}}</text>
        <text wx:if="{{publicId}}" class="public-id">会员编号 {{publicId}}</text>
        <text wx:if="{{phoneMasked}}" class="phone-masked">已验证手机号 {{phoneMasked}}</text>
      </view>
      <fui-tag
        text="{{levelName || '会员'}}"
        background="#F5EBF0"
        color="#7A284F"
        border-color="#E2E4E9"
        size="20"
        padding="9rpx 16rpx"
        radius="99"
      />
    </view>

    <view class="order-card surface">
      <view class="card-head">
        <text class="card-title">我的订单</text>
        <view
          class="card-link"
          bindtap="goAllOrders"
          aria-role="button"
          aria-label="查看全部订单"
        >
          <text>全部订单</text>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </view>
      </view>

      <view class="order-grid">
        <!-- order/list tabs: 0全部 1待确认 2待发货 3待收货 4已完成 -->
        <view
          class="order-entry"
          data-tab="1"
          bindtap="goOrderTab"
          aria-role="button"
          aria-label="待确认订单"
        >
          <view class="entry-mark" aria-hidden="true">
            <fui-icon name="wait" size="36" color="#7A284F" disabled aria-hidden="true" />
          </view>
          <text>待确认</text>
        </view>
        <view
          class="order-entry"
          data-tab="2"
          bindtap="goOrderTab"
          aria-role="button"
          aria-label="待发货订单"
        >
          <view class="entry-mark" aria-hidden="true">
            <fui-icon name="sendout" size="36" color="#7A284F" disabled aria-hidden="true" />
          </view>
          <text>待发货</text>
        </view>
        <view
          class="order-entry"
          data-tab="3"
          bindtap="goOrderTab"
          aria-role="button"
          aria-label="待收货订单"
        >
          <view class="entry-mark" aria-hidden="true">
            <fui-icon name="receive" size="36" color="#7A284F" disabled aria-hidden="true" />
          </view>
          <text>待收货</text>
        </view>
        <view
          class="order-entry"
          bindtap="goAftersaleList"
          aria-role="button"
          aria-label="查看退款售后"
        >
          <view class="entry-mark" aria-hidden="true">
            <fui-icon name="aftersale" size="36" color="#7A284F" disabled aria-hidden="true" />
          </view>
          <text>退款售后</text>
        </view>
      </view>
    </view>

    <view class="service-section">
      <view class="section-heading">
        <text class="section-title">常用服务</text>
      </view>

      <view class="service-card surface">
        <view class="service-row hairline-b" bindtap="goProfileEdit" aria-role="button" aria-label="更新会员头像与昵称">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="edit" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">更新头像与昵称</text>
              <text class="service-hint">主动确认或更换会员资料</text>
            </view>
          </view>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </view>

        <view class="service-row hairline-b" bindtap="goMemberCenter" aria-role="button" aria-label="进入会员中心">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="idcard" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">会员中心</text>
              <text class="service-hint">查看等级、积分与直推信息</text>
            </view>
          </view>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </view>

        <view class="service-row hairline-b" bindtap="goNotify" aria-role="button" aria-label="查看消息通知">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="notice" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">消息通知</text>
              <text class="service-hint">查看订单与售后通知</text>
            </view>
          </view>
          <view class="service-right">
            <fui-badge
              wx:if="{{unreadCount > 0}}"
              value="{{unreadCount}}"
              max="99"
              background="#B73F59"
            />
            <view class="chevron" aria-hidden="true">
              <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
            </view>
          </view>
        </view>

        <view class="service-row hairline-b" bindtap="goAddress" aria-role="button" aria-label="管理收货地址">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="location" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">收货地址</text>
              <text class="service-hint">管理订单收货信息</text>
            </view>
          </view>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </view>

        <view class="service-row hairline-b" bindtap="goAftersaleList" aria-role="button" aria-label="查看退款售后">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="aftersale" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">退款售后</text>
              <text class="service-hint">查看申请与处理进度</text>
            </view>
          </view>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </view>

        <view class="service-row hairline-b" bindtap="goSuperiorOrders" aria-role="button" aria-label="查看上级待确认订单">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="principal" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">上级待确认订单</text>
              <text class="service-hint">查看需要你确认的订单</text>
            </view>
          </view>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </view>

        <view class="service-row hairline-b" bindtap="goRules" aria-role="button" aria-label="查看规则说明">
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="help" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">规则说明</text>
              <text class="service-hint">查看当前生效的规则配置</text>
            </view>
          </view>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </view>

        <button
          class="service-row contact-row"
          open-type="contact"
          hover-class="none"
          aria-label="联系客服"
        >
          <view class="service-main">
            <view class="service-icon" aria-hidden="true">
              <fui-icon name="kefu" size="32" color="#7A284F" disabled aria-hidden="true" />
            </view>
            <view>
              <text class="service-label">联系客服</text>
              <text class="service-hint">使用微信客服能力发起咨询</text>
            </view>
          </view>
          <view class="chevron" aria-hidden="true">
            <fui-icon name="arrowright" size="28" color="#6F656B" disabled aria-hidden="true" />
          </view>
        </button>
      </view>
    </view>

    <button
      class="logout-button"
      loading="{{loggingOut}}"
      disabled="{{loggingOut}}"
      bindtap="onLogout"
    >
      <view class="logout-icon" aria-hidden="true">
        <fui-icon name="switch" size="30" color="#7A284F" disabled aria-hidden="true" />
      </view>
      <text>{{loggingOut ? '正在退出…' : '退出登录'}}</text>
    </button>
    <text class="logout-note">退出后，再次使用需重新完成微信登录</text>
    </block>
  </view>
</brand-shell>
