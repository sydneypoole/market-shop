<view class="page">
  <view class="user-card">
    <view class="avatar serif">拾</view>
    <view class="user-meta">
      <text class="nickname">{{nickname || '拾光会员'}}</text>
      <view class="tag member-tag">普通会员</view>
    </view>
  </view>

  <view class="block order-block">
    <view class="block-head hairline-b">
      <text class="block-title">我的订单</text>
      <view class="block-link" bindtap="goAllOrders">
        <text>全部订单</text>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="order-entries">
      <!-- order/list tabs: 0全部 1待确认 2待发货 3待收货 4已完成 -->
      <view class="order-entry" data-tab="1" bindtap="goOrderTab">
        <view class="entry-icon serif">☰</view>
        <text class="entry-label">待确认</text>
      </view>
      <view class="order-entry" data-tab="2" bindtap="goOrderTab">
        <view class="entry-icon">▣</view>
        <text class="entry-label">待发货</text>
      </view>
      <view class="order-entry" data-tab="3" bindtap="goOrderTab">
        <view class="entry-icon">🚚</view>
        <text class="entry-label">待收货</text>
      </view>
    </view>
  </view>

  <view class="block service-block">
    <view class="service-row hairline-b" bindtap="goAddress">
      <text class="service-label">收货地址</text>
      <text class="chevron">›</text>
    </view>
    <view class="service-row hairline-b" bindtap="onContact">
      <text class="service-label">联系客服</text>
      <text class="chevron">›</text>
    </view>
    <view class="service-row" bindtap="onAbout">
      <text class="service-label">关于拾光优选</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">积分不可提现、不可转让、不可兑换现金 · 奖励关系仅直属一层</text>
  </view>
</view>
