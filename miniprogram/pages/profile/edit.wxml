<brand-shell
  loading="{{loading || saving || privacyRequesting}}"
  loading-text="{{privacyRequesting ? '正在确认隐私授权' : (saving ? (nicknameSaved ? '正在上传头像' : '正在保存资料') : '正在读取会员资料')}}"
  tone="quiet"
  aria-label="编辑会员头像与昵称"
>
  <view class="page profile-page">
    <view class="custom-nav" style="padding-top: {{navigation.statusBarHeight}}px" aria-label="会员资料导航">
      <view class="custom-nav-bar" style="height: {{navigation.navigationBarHeight}}px">
        <button
          class="nav-home"
          style="width: {{navigation.sideWidth}}px"
          disabled="{{loading || saving || privacyRequesting}}"
          bindtap="goHome"
          aria-label="返回商城首页"
        >
          <fui-icon name="home" size="30" color="#7A284F" disabled aria-hidden="true" />
          <text>返回首页</text>
        </button>
        <text class="nav-title">编辑会员资料</text>
        <view class="nav-balance" style="width: {{navigation.sideWidth}}px" aria-hidden="true"></view>
      </view>
    </view>

    <view wx:if="{{!loading && loadError}}" class="load-error-section">
      <empty
        text="{{loadError}}"
        hint="资料加载成功后才会允许更新"
        buttonText="重新加载"
        icon="nonetwork"
        bind:action="loadProfile"
      />
      <button
        class="load-home"
        disabled="{{loading || saving || privacyRequesting}}"
        bindtap="goHome"
      >暂不更新，进入商城</button>
    </view>

    <view wx:elif="{{loaded}}" class="profile-editor surface" aria-label="会员资料编辑区域">
      <view class="profile-summary">
        <button
          class="avatar-picker"
          open-type="chooseAvatar"
          disabled="{{loading || saving || !privacyAgreed || !privacyAuthorized}}"
          bindchooseavatar="onChooseAvatar"
          aria-label="选择新会员头像"
        >
          <view class="profile-avatar">
            <image
              wx:if="{{avatarTempPath}}"
              class="profile-avatar__image"
              src="{{avatarTempPath}}"
              mode="aspectFill"
              binderror="onAvatarPreviewError"
              aria-role="img"
              aria-label="待保存的会员头像"
            />
            <image
              wx:elif="{{avatarUrl && !avatarFailed}}"
              class="profile-avatar__image"
              src="{{avatarUrl}}"
              mode="aspectFill"
              binderror="onAvatarError"
              aria-role="img"
              aria-label="{{authoritativeNickname || '会员'}}的当前头像"
            />
            <text wx:else class="profile-avatar__fallback" aria-label="当前头像占位">{{avatarFallback}}</text>
            <view class="profile-avatar__edit" aria-hidden="true">
              <fui-icon name="camera" size="28" color="#FFFFFF" disabled aria-hidden="true" />
            </view>
          </view>
          <text class="avatar-picker__action">{{avatarTempPath ? '重新选择头像' : (privacyAuthorized ? '选择头像' : '同意隐私指引后可选择')}}</text>
        </button>

        <view class="profile-summary__copy">
          <text class="profile-summary__status">{{nicknameSaved && avatarTempPath ? '头像待上传' : ((avatarTempPath || nickname != authoritativeNickname) ? '待保存资料' : '当前资料')}}</text>
          <text class="profile-summary__name">{{nickname || authoritativeNickname || '尚未设置昵称'}}</text>
          <text wx:if="{{nickname != authoritativeNickname}}" class="profile-summary__baseline">当前昵称：{{authoritativeNickname || '尚未设置'}}</text>
          <text wx:elif="{{avatarTempPath}}" class="profile-summary__baseline">新头像将在确认后上传</text>
          <text wx:else class="profile-summary__baseline">{{avatarUrl && !avatarFailed ? '已保存会员头像' : '尚未设置会员头像'}}</text>
        </view>
      </view>

      <view class="profile-section">
        <view class="section-heading">
          <view class="section-heading__copy">
            <text class="section-title">隐私授权</text>
            <text class="section-description">同意后启用微信头像与昵称能力，不会索取手机号</text>
          </view>
          <text class="section-state">{{privacyAuthorized ? '已授权' : '待授权'}}</text>
        </view>

        <view class="privacy-actions">
          <checkbox-group class="privacy-check-group" bindchange="onPrivacyAgreementChange">
            <label class="privacy-check">
              <checkbox
                value="accepted"
                checked="{{privacyAgreed}}"
                disabled="{{loading || saving || privacyRequesting}}"
                color="#7A284F"
              />
              <text>我已阅读并同意</text>
            </label>
          </checkbox-group>
          <button
            class="privacy-link"
            disabled="{{loading || saving || privacyRequesting}}"
            bindtap="openPrivacyContract"
          >《用户隐私保护指引》</button>
        </view>
        <text wx:if="{{privacyError}}" class="profile-field-error" aria-live="assertive">{{privacyError}}</text>
      </view>

      <view class="profile-section nickname-section">
        <view class="section-heading section-heading--field">
          <text class="section-title">会员昵称</text>
          <text class="section-state">{{nickname != authoritativeNickname ? '待保存' : '当前'}}</text>
        </view>
        <input
          class="profile-input {{nicknameError ? 'profile-input--error' : ''}}"
          type="nickname"
          maxlength="32"
          value="{{nickname}}"
          disabled="{{loading || saving || !privacyAgreed || !privacyAuthorized}}"
          placeholder="请选择或输入微信昵称"
          placeholder-class="profile-placeholder"
          bindinput="onNicknameInput"
          aria-label="会员昵称"
        />
        <text wx:if="{{nicknameError}}" class="profile-field-error" aria-live="assertive">{{nicknameError}}</text>
      </view>

      <view wx:if="{{avatarError}}" class="profile-field-error profile-avatar-error" aria-live="assertive">{{avatarError}}</view>

      <view wx:if="{{saveError}}" class="profile-save-error" aria-live="assertive">
        <fui-icon name="info" size="28" color="#B73F59" disabled aria-hidden="true" />
        <text>{{saveError}}</text>
      </view>

      <view class="edit-actions">
        <button
          class="save-button"
          loading="{{saving}}"
          disabled="{{loading || saving || privacyRequesting || ((nickname != authoritativeNickname || avatarTempPath) && (!privacyAgreed || !privacyAuthorized))}}"
          bindtap="onSave"
        >{{saving ? (nicknameSaved ? '正在上传头像…' : '正在保存…') : (nicknameSaved && avatarTempPath ? '重试上传头像' : '确认并进入商城')}}</button>
        <button
          class="skip-button"
          disabled="{{loading || saving || privacyRequesting}}"
          bindtap="onSkip"
        >暂不更新，进入商城</button>
      </view>

      <view class="save-sequence-note">
        <fui-icon name="lock" size="28" color="#7A284F" disabled aria-hidden="true" />
        <text>昵称先保存、头像后上传；头像失败时重试不会重复保存昵称</text>
      </view>
    </view>
  </view>
</brand-shell>
