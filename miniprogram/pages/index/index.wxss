.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.state {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 28rpx;
}

.announce {
  margin: 16rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: var(--canvas);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: none;
}

.announce-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.announce-icon {
  color: var(--muted);
  font-size: 24rpx;
  flex-shrink: 0;
}

.announce-text {
  color: var(--ink-soft);
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.announce-arrow {
  color: var(--muted);
  font-size: 28rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.search-wrap {
  padding: 24rpx 32rpx 0;
}

.search-box {
  height: 72rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
  background: var(--paper);
}

.search-icon {
  color: var(--muted);
  font-size: 28rpx;
}

.search-placeholder {
  color: var(--muted);
  font-size: 26rpx;
}

.chip-scroll {
  white-space: nowrap;
  padding: 24rpx 32rpx 8rpx;
  width: 100%;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius);
  font-size: 24rpx;
  color: var(--ink-soft);
  background: var(--paper);
  vertical-align: top;
}

.chip-all {
  border-color: var(--ink);
  color: var(--ink);
  font-weight: 500;
}

.hero {
  padding: 24rpx 32rpx 8rpx;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border: 2rpx solid var(--coral);
  border-radius: var(--radius);
  color: var(--coral);
  font-size: 20rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 24rpx;
}

.hero-visual {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--canvas);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  background: var(--canvas);
}

.hero-meta-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-meta {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.hero-meta-arrow {
  color: var(--muted);
  font-size: 24rpx;
}

.section {
  padding: 40rpx 32rpx 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  color: var(--ink);
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.section-more-arrow {
  font-size: 28rpx;
  line-height: 1;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.grid-item {
  width: 50%;
  padding: 0 10rpx 20rpx;
  box-sizing: border-box;
}

.story-section {
  padding-bottom: 16rpx;
}

.story-card {
  background: var(--paper);
}

.story-cover {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius);
  display: block;
  background: var(--canvas);
}

.story-cover-empty {
  background: var(--canvas);
}

.story-title {
  display: block;
  margin-top: 24rpx;
  font-size: 32rpx;
  color: var(--ink);
}

.story-summary {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.story-tags {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.story-meta {
  font-size: 22rpx;
  color: var(--muted);
}

.service-row {
  margin-top: 48rpx;
  padding: 32rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.service-icon {
  font-size: 32rpx;
  color: var(--ink-soft);
  line-height: 1;
}

.service-label {
  font-size: 22rpx;
  color: var(--muted);
}
