.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 44rpx;
}

.welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 176rpx;
  padding: 8rpx 6rpx 18rpx;
}

.welcome-copy {
  flex: 1;
  min-width: 0;
}

.welcome-title,
.welcome-note {
  display: block;
}

.welcome-title {
  margin-top: 8rpx;
  color: var(--brand-ink);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.25;
}

.welcome-note {
  max-width: 500rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.welcome-mark {
  width: 112rpx;
  height: 112rpx;
  margin-left: 24rpx;
  overflow: hidden;
  border: 2rpx solid rgba(122, 40, 79, 0.08);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: var(--brand-shadow-soft);
}

.welcome-mark image {
  width: 100%;
  height: 100%;
}

.search-control {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(234, 221, 226, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--brand-shadow-soft);
}

.search-symbol {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 18rpx;
  border: 4rpx solid var(--brand-plum);
  border-radius: 50%;
}

.search-symbol::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--brand-plum);
  content: '';
  transform: rotate(45deg);
}

.search-placeholder {
  flex: 1;
  color: var(--brand-muted);
  font-size: 26rpx;
}

.search-action {
  color: var(--brand-plum);
  font-size: 23rpx;
  font-weight: 600;
}

.category-scroll {
  width: calc(100% + 56rpx);
  margin: 24rpx -28rpx 0;
  white-space: nowrap;
}

.category-track {
  display: inline-flex;
  padding: 2rpx 28rpx 10rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  min-height: 62rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--brand-ink-soft);
  font-size: 24rpx;
}

.category-chip--all {
  border-color: var(--brand-plum);
  background: var(--brand-plum);
  color: #FFFFFF;
  font-weight: 600;
}

.hero-card {
  position: relative;
  height: 560rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border: 2rpx solid rgba(122, 40, 79, 0.08);
  border-radius: 38rpx;
  background: linear-gradient(145deg, #f2dce4, #ccb1bd);
  box-shadow: var(--brand-shadow);
}

.hero-image,
.hero-placeholder,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 74% 16%, rgba(255, 255, 255, 0.72), transparent 28%),
    linear-gradient(145deg, #f6dde6, #a86782);
}

.hero-placeholder-logo {
  width: 260rpx;
  height: 260rpx;
  opacity: 0.38;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(37, 26, 32, 0.06), rgba(37, 26, 32, 0.76));
}

.hero-content {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 40rpx 36rpx 34rpx;
}

.hero-title {
  display: block;
  max-width: 590rpx;
  margin-top: 18rpx;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.32;
  text-shadow: 0 4rpx 18rpx rgba(37, 26, 32, 0.24);
}

.hero-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 20rpx;
}

.hero-meta {
  max-width: 560rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 1.45;
}

.hero-arrow {
  margin-left: 20rpx;
  color: #FFFFFF;
  font-size: 32rpx;
}

.section {
  margin-top: 60rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 0 4rpx;
}

.section-title {
  display: block;
  margin-top: 5rpx;
  color: var(--brand-ink);
  font-size: 38rpx;
  font-weight: 600;
}

.section-link {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding-left: 20rpx;
  color: var(--brand-plum);
  font-size: 24rpx;
}

.chevron {
  margin-left: 6rpx;
  font-size: 34rpx;
  line-height: 1;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -9rpx;
}

.product-cell {
  width: 50%;
  padding: 0 9rpx 18rpx;
}

.section-empty {
  overflow: hidden;
}

.story-section {
  margin-top: 44rpx;
}

.story-meta {
  color: var(--brand-muted);
  font-size: 22rpx;
}

.story-card {
  overflow: hidden;
}

.story-cover {
  display: block;
  width: 100%;
  height: 330rpx;
  background: var(--brand-canvas);
}

.story-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 72% 22%, rgba(255, 255, 255, 0.9), transparent 28%),
    linear-gradient(135deg, var(--brand-pink), #ead7dc);
}

.story-leaf {
  width: 92rpx;
  height: 146rpx;
  border: 8rpx solid rgba(122, 40, 79, 0.46);
  border-top-left-radius: 82rpx;
  border-bottom-right-radius: 82rpx;
  transform: rotate(34deg);
}

.story-body {
  padding: 28rpx 28rpx 32rpx;
}

.story-title,
.story-summary,
.story-link {
  display: block;
}

.story-title {
  margin-top: 18rpx;
  color: var(--brand-ink);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.story-summary {
  margin-top: 12rpx;
  color: var(--brand-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.story-link {
  margin-top: 24rpx;
  color: var(--brand-plum);
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
