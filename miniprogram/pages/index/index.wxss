.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 44rpx;
}

.welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 148rpx;
  padding: 4rpx 4rpx 20rpx;
}

.welcome-copy {
  flex: 1;
  min-width: 0;
}

.welcome-title,
.welcome-note {
  display: block;
}

.welcome-title {
  color: var(--brand-ink);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.welcome-note {
  max-width: 500rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.welcome-mark {
  width: 96rpx;
  height: 96rpx;
  margin-left: 24rpx;
  overflow: hidden;
  border: 2rpx solid rgba(122, 40, 79, 0.08);
  border-radius: var(--brand-radius-card);
  background: #FFFFFF;
}

.welcome-mark image {
  width: 100%;
  height: 100%;
}

.search-control {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(234, 221, 226, 0.9);
  border-radius: var(--brand-radius-control);
  background: #FFFFFF;
}

.search-placeholder {
  flex: 1;
  margin-left: 16rpx;
  color: var(--brand-muted);
  font-size: 26rpx;
}

.category-scroll {
  width: calc(100% + 56rpx);
  margin: 24rpx -28rpx 0;
  white-space: nowrap;
}

.category-track {
  display: inline-flex;
  padding: 2rpx 28rpx 10rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--brand-ink-soft);
  font-size: 24rpx;
}

.category-chip--all {
  border-color: var(--brand-plum);
  background: var(--brand-plum);
  color: #FFFFFF;
  font-weight: 600;
}

.hero-card {
  position: relative;
  height: 560rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border: 2rpx solid rgba(122, 40, 79, 0.08);
  border-radius: var(--brand-radius-card);
  background: var(--brand-line-strong);
  box-shadow: var(--brand-shadow);
}

.hero-image,
.hero-placeholder,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(145deg, var(--brand-line), var(--brand-line-strong));
}

.hero-placeholder-logo {
  width: 260rpx;
  height: 260rpx;
  opacity: 0.38;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(37, 26, 32, 0.06), rgba(37, 26, 32, 0.76));
}

.hero-content {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 40rpx 36rpx 34rpx;
}

.hero-title {
  display: block;
  max-width: 590rpx;
  margin-top: 12rpx;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.32;
  text-shadow: 0 4rpx 18rpx rgba(37, 26, 32, 0.24);
}

.hero-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
  font-weight: 600;
}

.hero-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 20rpx;
}

.hero-meta {
  max-width: 560rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 1.45;
}

.section {
  margin-top: 60rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 0 4rpx;
}

.section-title {
  display: block;
  color: var(--brand-ink);
  font-size: 34rpx;
  font-weight: 700;
}

.section-sub {
  display: block;
  margin-top: 5rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
}

.section-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding-left: 20rpx;
  color: var(--brand-plum);
  font-size: 24rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -9rpx;
}

.product-cell {
  width: 50%;
  padding: 0 9rpx 18rpx;
}

.section-empty {
  overflow: hidden;
}

.story-section {
  margin-top: 44rpx;
}

.story-meta {
  color: var(--brand-muted);
  font-size: 22rpx;
}

.story-card {
  overflow: hidden;
  box-shadow: none;
}

.story-cover {
  display: block;
  width: 100%;
  height: 330rpx;
  background: var(--brand-canvas);
}

.story-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-pink-soft);
}

.story-body {
  padding: 28rpx 28rpx 32rpx;
}

.story-title,
.story-summary,
.story-link {
  display: block;
}

.story-title {
  margin-top: 18rpx;
  color: var(--brand-ink);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.story-summary {
  margin-top: 12rpx;
  color: var(--brand-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.story-link {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  color: var(--brand-plum);
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.story-link text { margin-right: 6rpx; }
