<brand-shell
  loading="{{loading}}"
  loading-text="正在准备首页"
  tone="hero"
  safe-bottom="{{true}}"
  aria-label="宏杉生物首页"
>
  <view class="page">
    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      bind:action="loadHome"
    />

    <block wx:elif="{{!loading}}">
      <view class="welcome">
        <view class="welcome-copy">
          <text class="section-eyebrow">宏杉生物</text>
          <text class="welcome-title serif">商城首页</text>
          <text class="welcome-note">{{announcement}}</text>
        </view>
        <view class="welcome-mark" aria-hidden="true">
          <image src="/assets/brand/logo.png" mode="aspectFit" />
        </view>
      </view>

      <view
        class="search-control"
        bindtap="onTapSearch"
        aria-role="button"
        aria-label="搜索商品"
      >
        <view class="search-symbol" aria-hidden="true"></view>
        <text class="search-placeholder">搜索商品</text>
        <text class="search-action">去搜索</text>
      </view>

      <scroll-view
        wx:if="{{categories.length}}"
        class="category-scroll"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        aria-label="商品分类"
      >
        <view class="category-track">
          <view
            class="category-chip category-chip--all"
            data-id=""
            data-name="全部"
            bindtap="onTapCategory"
            aria-role="button"
          >全部商品</view>
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="category-chip"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            bindtap="onTapCategory"
            aria-role="button"
          >{{item.name}}</view>
        </view>
      </scroll-view>

      <view
        class="hero-card"
        data-id="{{heroId}}"
        bindtap="onTapContent"
        aria-role="button"
        aria-disabled="{{!heroId}}"
        aria-label="{{heroTitle}}"
      >
        <image wx:if="{{heroCover}}" class="hero-image" src="{{heroCover}}" mode="aspectFill" />
        <view wx:else class="hero-placeholder">
          <image class="hero-placeholder-logo" src="/assets/brand/logo.png" mode="aspectFit" />
        </view>
        <view class="hero-shade"></view>
        <view class="hero-content">
          <fui-tag
            text="内容导览"
            background="rgba(255,255,255,0.9)"
            color="#7A284F"
            border-color="rgba(255,255,255,0.5)"
            size="20"
            padding="8rpx 16rpx"
            radius="99"
          />
          <text class="hero-title serif">{{heroTitle}}</text>
          <view class="hero-foot">
            <text class="hero-meta">{{heroId ? '点击查看内容详情' : '内容导览'}}</text>
            <text wx:if="{{heroId}}" class="hero-arrow" aria-hidden="true">→</text>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-head">
          <view>
            <text class="section-eyebrow">商城商品</text>
            <text class="section-title serif">商品列表</text>
          </view>
          <view
            class="section-link"
            bindtap="onTapAllProducts"
            aria-role="button"
            aria-label="查看全部商品"
          >
            <text>查看全部</text>
            <text class="chevron" aria-hidden="true">›</text>
          </view>
        </view>

        <view wx:if="{{products.length}}" class="product-grid">
          <view
            wx:for="{{products}}"
            wx:key="productId"
            class="product-cell"
            data-id="{{item.productId}}"
            bindtap="onTapProduct"
            aria-role="button"
          >
            <goods-card
              cover="{{item.cover}}"
              name="{{item.name}}"
              priceFen="{{item.priceFen}}"
              marketPriceFen="{{item.marketPriceFen}}"
            />
          </view>
        </view>
        <view wx:else class="section-empty surface">
          <empty text="暂无可展示商品" hint="稍后再来看看" />
        </view>
      </view>

      <view wx:if="{{story.id}}" class="section story-section">
        <view class="section-head">
          <view>
            <text class="section-eyebrow">品牌内容</text>
            <text class="section-title serif">内容故事</text>
          </view>
          <text class="story-meta">{{story.meta}}</text>
        </view>

        <view
          class="story-card surface"
          data-id="{{story.id}}"
          bindtap="onTapContent"
          aria-role="button"
          aria-disabled="{{!story.id}}"
          aria-label="{{story.title}}"
        >
          <image
            wx:if="{{story.coverUrl}}"
            class="story-cover"
            src="{{story.coverUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="story-cover story-cover--empty">
            <view class="story-leaf" aria-hidden="true"></view>
          </view>
          <view class="story-body">
            <fui-tag
              text="{{story.tag}}"
              theme="light"
              type="purple"
              size="19"
              padding="7rpx 14rpx"
              radius="99"
            />
            <text class="story-title serif">{{story.title}}</text>
            <text class="story-summary">{{story.summary}}</text>
            <text wx:if="{{story.id}}" class="story-link">阅读详情 →</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</brand-shell>
