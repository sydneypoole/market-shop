.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.row {
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--line);
}

.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.row-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--coral);
  flex-shrink: 0;
}

.row-title {
  font-size: 28rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-title.unread {
  color: var(--ink);
  font-weight: 500;
}

.row-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--muted);
}

.row-content {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

.row-content.clamp {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.more {
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
