.page { min-height:100vh; padding:32rpx 28rpx calc(52rpx + env(safe-area-inset-bottom)); }
.page-intro { padding:4rpx 0 28rpx; }
.page-title,.page-subtitle,.field-label,.field-value,.field-placeholder,.field-caption { display:block; }
.page-title { color:var(--brand-ink); font-size:44rpx; font-weight:700; line-height:1.2; letter-spacing:-1rpx; }
.page-subtitle { margin-top:10rpx; color:var(--brand-muted); font-size:23rpx; }
.form-card { overflow:hidden; padding:0 24rpx; border-radius:var(--brand-radius-card); box-shadow:none; }
.field { display:flex; align-items:center; gap:20rpx; min-height:112rpx; }
.field-label { width:146rpx; flex-shrink:0; color:var(--brand-ink); font-size:24rpx; font-weight:650; }
.field-input { flex:1; min-width:0; height:76rpx; color:var(--brand-ink); font-size:25rpx; line-height:76rpx; text-align:right; }
.field-placeholder { color:#8A8D96; }
.field--picker { min-height:112rpx; }
.field-copy { display:flex; flex:1; align-items:center; justify-content:space-between; gap:20rpx; min-width:0; }
.field-value { flex:1; overflow:hidden; color:var(--brand-ink-soft); font-size:24rpx; text-align:right; text-overflow:ellipsis; white-space:nowrap; }
.field-chevron { flex-shrink:0; }
.field--stack { display:block; padding:20rpx 0; }
.field--stack .field-label { width:auto; }
.field-input--wide { width:100%; margin-top:8rpx; text-align:left; }
.field--switch { justify-content:space-between; }
.field--switch .field-copy { display:block; }
.field-caption { margin-top:4rpx; color:var(--brand-muted); font-size:20rpx; }
.action-stack { margin-top:24rpx; }
.save-btn { width:100%; min-height:88rpx; margin:0; }
.delete-btn { width:100%; min-height:88rpx; margin:14rpx 0 0; padding:0 28rpx; border:2rpx solid rgba(183,63,89,.25); border-radius:999rpx; background:#fff; color:var(--brand-danger); font-size:26rpx; font-weight:600; line-height:84rpx; }
.delete-btn::after { border:0; }
.delete-btn:active { transform:scale(.98); }
.delete-btn[disabled] { opacity:.48; }
