.page { min-height:100vh; padding:32rpx 28rpx 52rpx; }
.page--with-footer { padding-bottom:calc(184rpx + env(safe-area-inset-bottom)); }
.page-intro { padding:4rpx 0 28rpx; }
.page-title,.page-subtitle,.name,.phone,.detail,.version-note,.footer-hint { display:block; }
.page-title { color:var(--brand-ink); font-size:44rpx; font-weight:700; line-height:1.2; letter-spacing:-1rpx; }
.page-subtitle { margin-top:10rpx; color:var(--brand-muted); font-size:23rpx; }
.address-list { overflow:hidden; border:2rpx solid var(--brand-line); border-radius:var(--brand-radius-card); background:#fff; }
.address-card { padding:0 24rpx; border:0; border-bottom:2rpx solid var(--brand-line); border-radius:0; box-shadow:none; }
.address-card:last-child { border-bottom:0; }
.address-card--selectable:active { background:rgba(122,40,79,.025); }
.card-main { display:flex; align-items:flex-start; gap:16rpx; padding:26rpx 0 20rpx; }
.avatar { display:flex; align-items:center; justify-content:center; width:60rpx; height:60rpx; flex-shrink:0; border:2rpx solid var(--brand-line); border-radius:50%; background:var(--brand-canvas); }
.card-copy { flex:1; min-width:0; }
.identity-line { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx 14rpx; }
.name { color:var(--brand-ink); font-size:28rpx; font-weight:650; }
.phone { color:var(--brand-ink-soft); font-size:23rpx; font-variant-numeric:tabular-nums; }
.detail { margin-top:10rpx; color:var(--brand-muted); font-size:23rpx; line-height:1.55; word-break:break-all; }
.select-chevron { align-self:center; flex-shrink:0; }
.card-actions { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:88rpx; border-top:2rpx solid var(--brand-line); }
.version-note { color:var(--brand-muted); font-size:20rpx; }
.edit-btn { min-width:104rpx; min-height:88rpx; margin:0; padding:0 22rpx; border:0; background:transparent; color:var(--brand-plum); font-size:23rpx; line-height:88rpx; }
.edit-btn::after { border:0; }
.footer { position:fixed; z-index:60; right:0; bottom:0; left:0; padding:14rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:2rpx solid var(--brand-line); background:rgba(255,255,255,.98); box-shadow:0 -8rpx 24rpx rgba(32,33,38,.05); }
.add-btn { width:100%; min-height:88rpx; margin:0; gap:8rpx; }
.footer-hint { margin-top:8rpx; color:var(--brand-muted); font-size:19rpx; text-align:center; }
