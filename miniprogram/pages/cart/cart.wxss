.page { min-height: 100vh; padding: 32rpx 28rpx 48rpx; }
.page--with-footer { padding-bottom: calc(158rpx + env(safe-area-inset-bottom)); }
.page-intro { display:flex; align-items:flex-end; justify-content:space-between; gap:24rpx; padding:4rpx 0 30rpx; }
.intro-copy { flex:1; min-width:0; }
.page-title,.page-subtitle,.name,.sku,.price-prefix,.footer-label { display:block; }
.page-title { color:var(--brand-ink); font-size:44rpx; font-weight:700; line-height:1.2; letter-spacing:-1rpx; }
.page-subtitle { margin-top:10rpx; color:var(--brand-muted); font-size:23rpx; line-height:1.5; }
.page-subtitle--danger { color:var(--brand-danger); font-weight:600; }
.edit-btn { min-width:112rpx; min-height:88rpx; margin:0; padding:0 24rpx; border:2rpx solid var(--brand-line-strong); border-radius:999rpx; background:#fff; color:var(--brand-plum); font-size:24rpx; line-height:84rpx; }
.edit-btn::after { border:0; }
.edit-btn--active { border-color:var(--brand-plum); background:rgba(122,40,79,.06); }
.cart-list { overflow:hidden; border:2rpx solid var(--brand-line); border-radius:var(--brand-radius-card); background:#fff; }
.cart-card { display:flex; align-items:center; gap:18rpx; padding:24rpx 20rpx; border:0; border-bottom:2rpx solid var(--brand-line); border-radius:0; box-shadow:none; }
.cart-card:last-child { border-bottom:0; }
.cart-card--unavailable { background:rgba(183,63,89,.035); }
.check { position:relative; display:flex; align-items:center; justify-content:center; width:56rpx; min-width:56rpx; height:88rpx; min-height:88rpx; margin:0; padding:0; border:0; border-radius:0; background:transparent; line-height:1; }
.check::before { content:""; width:36rpx; height:36rpx; border:2rpx solid var(--brand-line-strong); border-radius:50%; background:#fff; }
.check::after { border:0; }
.check[disabled] { opacity:.48; }
.check--checked::before { position:absolute; border-color:var(--brand-plum); background:var(--brand-plum); }
.check fui-icon { position:relative; z-index:1; }
.cover { width:148rpx; height:148rpx; flex-shrink:0; border-radius:var(--brand-radius-control); background:var(--brand-cream); }
.cover--placeholder { display:flex; align-items:center; justify-content:center; border:2rpx solid var(--brand-line); background:var(--brand-canvas); color:var(--brand-muted); font-size:24rpx; font-weight:600; letter-spacing:2rpx; }
.meta { display:flex; flex:1; flex-direction:column; min-width:0; min-height:148rpx; }
.name { overflow:hidden; color:var(--brand-ink); font-size:27rpx; font-weight:650; line-height:1.42; text-overflow:ellipsis; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.sku { margin-top:7rpx; overflow:hidden; color:var(--brand-muted); font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }
.meta-bottom { display:flex; align-items:flex-end; justify-content:space-between; gap:10rpx; margin-top:auto; padding-top:12rpx; }
.price-block { flex-shrink:0; }
.price-prefix { color:var(--brand-muted); font-size:18rpx; }
.price { color:var(--brand-plum); font-size:29rpx; line-height:1.2; font-variant-numeric:tabular-nums; }
.stepper-wrap { flex-shrink:0; transform:scale(.92); transform-origin:right bottom; }
.stepper-wrap--disabled { pointer-events:none; opacity:.48; }
.inventory-warning { display:flex; align-items:flex-end; flex-direction:column; gap:6rpx; }
.inventory-warning__text { max-width:220rpx; color:var(--brand-danger); font-size:20rpx; line-height:1.35; text-align:right; }
.inventory-warning__remove { min-width:88rpx; min-height:88rpx; margin:0; padding:0 16rpx; border:2rpx solid rgba(183,63,89,.28); border-radius:999rpx; background:#fff; color:var(--brand-danger); font-size:21rpx; line-height:84rpx; }
.inventory-warning__remove::after { border:0; }
.footer { position:fixed; z-index:60; right:0; bottom:0; left:0; display:flex; align-items:center; gap:12rpx; padding:14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:2rpx solid var(--brand-line); background:rgba(255,255,255,.98); box-shadow:0 -8rpx 24rpx rgba(32,33,38,.05); }
.select-all { display:flex; align-items:center; gap:4rpx; min-width:106rpx; min-height:88rpx; margin:0; padding:0; border:0; background:transparent; color:var(--brand-ink-soft); font-size:23rpx; }
.select-all::after { border:0; }
.select-all .check { width:52rpx; min-width:52rpx; }
.select-all .check::before { width:32rpx; height:32rpx; }
.footer-total { flex:1; min-width:0; text-align:right; }
.footer-label { color:var(--brand-muted); font-size:20rpx; }
.selected-count,.total-price { display:block; color:var(--brand-ink); font-size:30rpx; font-weight:700; font-variant-numeric:tabular-nums; }
.total-price { color:var(--brand-plum); }
.checkout { min-width:202rpx; min-height:88rpx; margin:0; padding:0 28rpx; white-space:nowrap; }
@media (prefers-reduced-motion: no-preference) { .cart-card:active { background:rgba(122,40,79,.025); } }
