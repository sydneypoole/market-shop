<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text>{{error}}</text>
    <button class="btn-outline retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
    <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="hero">
        <image wx:if="{{coverUrl}}" class="hero-img" src="{{coverUrl}}" mode="aspectFill" />
        <view wx:else class="hero-placeholder"></view>
      </view>

      <view class="info">
        <view class="price-row">
          <text class="price serif">¥{{priceText}}</text>
          <text wx:if="{{marketPriceText}}" class="market">¥{{marketPriceText}}</text>
          <view wx:if="{{showMemberTag}}" class="tag member-tag">会员价</view>
        </view>
        <text class="name serif">{{name}}</text>
        <text wx:if="{{attrSummary}}" class="attr-summary">{{attrSummary}}</text>

        <view class="service-row">
          <view class="service-item">
            <text class="service-icon">🛡</text>
            <text class="service-text">正品保障</text>
          </view>
          <view class="service-item">
            <text class="service-icon">📦</text>
            <text class="service-text">顺丰发货</text>
          </view>
          <view class="service-item">
            <text class="service-icon">♻</text>
            <text class="service-text">无忧售后</text>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">器物详情</text>
        <rich-text wx:if="{{descriptionHtml}}" class="desc" nodes="{{descriptionHtml}}"></rich-text>
        <text wx:else class="desc-empty">暂无图文详情</text>
      </view>

      <view wx:if="{{attrRows.length}}" class="params">
        <view
          wx:for="{{attrRows}}"
          wx:key="key"
          class="param-row {{index < attrRows.length - 1 ? 'hairline-b' : ''}}"
        >
          <text class="param-key">{{item.key}}</text>
          <text class="param-value">{{item.value}}</text>
        </view>
      </view>

      <view class="section notice">
        <text class="section-title">购买须知</text>
        <view class="notice-list">
          <text class="notice-item">· 手工艺器物存在 ±5% 容量误差与釉色差异，属正常工艺特征</text>
          <text class="notice-item">· 订单由直属上级确认线下收款后安排发货</text>
          <text class="notice-item">· 支持 7 天无理由退货（运费自理）</text>
        </view>
      </view>

      <view class="scroll-pad"></view>
    </scroll-view>

    <view class="bottom-bar hairline-t">
      <view class="side-actions">
        <button class="side-btn contact-btn" open-type="contact" hover-class="none">
          <text class="side-icon">💬</text>
          <text class="side-label">客服</text>
        </button>
        <view class="side-btn" bindtap="onGoCart">
          <text class="side-icon">🛒</text>
          <text class="side-label">购物车</text>
        </view>
      </view>
      <view class="main-actions">
        <button class="btn-outline action-cart" disabled="{{adding}}" bindtap="onAddCart">加入购物车</button>
        <button class="btn-primary action-buy" disabled="{{adding}}" bindtap="onBuyNow">立即购买</button>
      </view>
    </view>

    <sku-sheet
      visible="{{sheetVisible}}"
      product="{{detail}}"
      mode="{{sheetMode}}"
      bind:close="onSheetClose"
      bind:confirm="onSheetConfirm"
    />
  </block>
</view>
