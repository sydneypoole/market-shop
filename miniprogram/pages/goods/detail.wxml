<brand-shell
  loading="{{loading}}"
  loading-text="正在加载商品"
  tone="default"
  aria-label="商品详情"
>
  <view class="page">
    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="{{retryable ? '请检查网络后重试' : '请返回上一页重新选择'}}"
      buttonText="{{retryable ? '重新加载' : ''}}"
      bind:action="retryLoad"
    />

    <block wx:elif="{{!loading && detail}}">
      <view class="product-hero">
        <image
          wx:if="{{coverUrl}}"
          class="hero-image"
          src="{{coverUrl}}"
          mode="aspectFill"
          aria-role="img"
          aria-label="{{name}}"
        />
        <view wx:else class="hero-placeholder" aria-hidden="true">
          <image src="/assets/brand/logo.png" mode="aspectFit" />
        </view>
      </view>

      <view class="product-info surface">
        <view class="price-row">
          <text class="price"><text class="currency">¥</text>{{priceText}}</text>
          <view wx:if="{{marketPriceText}}" class="reference-price">
            <text class="reference-label">参考价</text>
            <text class="market">¥{{marketPriceText}}</text>
          </view>
        </view>
        <text class="product-name">{{name}}</text>
        <view wx:if="{{attrSummary}}" class="selected-summary">
          <text class="summary-label">默认规格</text>
          <text class="summary-value">{{attrSummary}}</text>
        </view>
      </view>

      <view wx:if="{{attrRows.length}}" class="section-card surface">
        <view class="section-heading">
          <text class="section-title">商品参数</text>
          <text class="section-count">{{attrRows.length}} 项</text>
        </view>
        <view class="parameter-list">
          <view
            wx:for="{{attrRows}}"
            wx:key="key"
            class="parameter-row {{index < attrRows.length - 1 ? 'hairline-b' : ''}}"
          >
            <text class="parameter-key">{{item.key}}</text>
            <text class="parameter-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <view class="section-card surface">
        <view class="section-heading">
          <text class="section-title">图文详情</text>
        </view>
        <rich-text
          wx:if="{{descriptionHtml}}"
          class="description"
          nodes="{{descriptionHtml}}"
        ></rich-text>
        <view wx:else class="description-empty">暂无图文详情</view>
      </view>

      <view class="content-spacer"></view>

      <view class="bottom-bar">
        <view class="side-actions">
          <button
            class="side-button"
            open-type="contact"
            hover-class="none"
            aria-label="联系客服"
          >
            <fui-icon name="kefu" size="38" color="#7A284F" disabled aria-hidden="true" />
            <text>客服</text>
          </button>
          <view
            class="side-button"
            bindtap="onGoCart"
            aria-role="button"
            aria-label="前往购物车"
          >
            <fui-icon name="cart" size="38" color="#7A284F" disabled aria-hidden="true" />
            <text>购物车</text>
          </view>
        </view>
        <view class="main-actions">
          <button
            class="btn-outline action-button"
            loading="{{adding}}"
            disabled="{{adding || !hasAvailableSku}}"
            bindtap="onAddCart"
          >{{adding ? '加入中…' : '加入购物车'}}</button>
          <button
            class="btn-primary action-button"
            disabled="{{adding || !hasAvailableSku}}"
            bindtap="onBuyNow"
          >立即购买</button>
        </view>
      </view>

      <sku-sheet
        visible="{{sheetVisible}}"
        product="{{detail}}"
        mode="{{sheetMode}}"
        pending="{{adding}}"
        bind:close="onSheetClose"
        bind:confirm="onSheetConfirm"
      />
    </block>

    <empty wx:elif="{{!loading}}" text="商品不存在或已下线" hint="请返回上一页重新选择" />
  </view>
</brand-shell>
