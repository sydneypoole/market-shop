.page {
  min-height: 100vh;
  padding: 20rpx 28rpx 0;
}

.product-hero {
  position: relative;
  height: 700rpx;
  overflow: hidden;
  border: 2rpx solid rgba(234, 221, 226, 0.82);
  border-radius: var(--brand-radius-card);
  background: var(--brand-canvas);
  box-shadow: none;
}

.hero-image,
.hero-placeholder {
  width: 100%;
  height: 100%;
}

.hero-image {
  display: block;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(145deg, var(--brand-line), var(--brand-line-strong));
}

.hero-placeholder image {
  width: 250rpx;
  height: 250rpx;
  opacity: 0.42;
}

.product-info {
  position: relative;
  z-index: 2;
  margin: 18rpx 0 0;
  padding: 34rpx 30rpx 32rpx;
}

.price-row {
  display: flex;
  align-items: flex-end;
  flex-wrap: wrap;
}

.price {
  color: var(--brand-plum);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.currency {
  margin-right: 3rpx;
  font-size: 27rpx;
}

.reference-price {
  display: flex;
  align-items: center;
  margin: 0 0 3rpx 18rpx;
}

.reference-label {
  margin-right: 8rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
}

.market {
  color: var(--brand-muted);
  font-size: 23rpx;
  text-decoration: line-through;
}

.product-name {
  display: block;
  margin-top: 18rpx;
  color: var(--brand-ink);
  font-size: 39rpx;
  font-weight: 600;
  line-height: 1.42;
}

.selected-summary {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--brand-radius-control);
  background: var(--brand-canvas);
}

.summary-label {
  flex-shrink: 0;
  margin-right: 18rpx;
  color: var(--brand-plum);
  font-size: 22rpx;
  font-weight: 600;
}

.summary-value {
  color: var(--brand-ink-soft);
  font-size: 23rpx;
  line-height: 1.5;
}

.section-card {
  margin-top: 22rpx;
  padding: 30rpx 28rpx 34rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  color: var(--brand-ink);
  font-size: 33rpx;
  font-weight: 700;
}

.section-count {
  color: var(--brand-muted);
  font-size: 22rpx;
}

.parameter-list {
  overflow: hidden;
  border-radius: var(--brand-radius-control);
  background: var(--brand-canvas);
  padding: 0 20rpx;
}

.parameter-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 22rpx 0;
}

.parameter-key {
  flex-shrink: 0;
  max-width: 220rpx;
  margin-right: 28rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
}

.parameter-value {
  color: var(--brand-ink-soft);
  font-size: 25rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.description {
  display: block;
  width: 100%;
  overflow-wrap: anywhere;
  color: var(--brand-ink-soft);
  font-size: 27rpx;
  line-height: 1.82;
}

.description-empty {
  padding: 42rpx 0;
  color: var(--brand-muted);
  font-size: 24rpx;
  text-align: center;
}

.content-spacer {
  height: calc(154rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(234, 221, 226, 0.92);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(32, 33, 38, 0.06);
}

.side-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-right: 14rpx;
}

.side-button {
  display: flex;
  width: 78rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 5rpx 0 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--brand-muted);
  font-size: 19rpx;
  line-height: 1.25;
}

.side-button::after {
  border: none;
}

.side-button fui-icon { margin-bottom: 7rpx; }

.main-actions {
  display: flex;
  flex: 1;
  min-width: 0;
}

.action-button {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0 15rpx;
  font-size: 25rpx;
}

.action-button + .action-button {
  margin-left: 12rpx;
}
