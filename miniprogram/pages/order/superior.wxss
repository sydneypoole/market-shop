.page {
  min-height: 100vh;
  background: var(--canvas);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.hint-banner {
  padding: 28rpx 32rpx;
  background: var(--paper);
  border-bottom: 2rpx solid var(--line);
}

.hint-text {
  font-size: 24rpx;
  color: var(--muted);
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--muted);
}

.status {
  font-size: 24rpx;
}

.tone-coral { color: var(--coral); }
.tone-gold { color: var(--gold); }
.tone-green { color: var(--green); }
.tone-muted { color: var(--muted); }

.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.amount-label {
  font-size: 28rpx;
  color: var(--ink);
}

.amount-row .price {
  font-size: 32rpx;
}

.time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
