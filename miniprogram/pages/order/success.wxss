.page {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
}

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.check-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-mark {
  color: var(--green);
  font-size: 56rpx;
  line-height: 1;
  font-weight: 500;
}

.title {
  margin-top: 40rpx;
  font-size: 44rpx;
  color: var(--ink);
  line-height: 1.3;
}

.order-no {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.guide-card {
  width: 100%;
  margin-top: 56rpx;
  padding: 32rpx 28rpx;
  background: var(--canvas);
  border-radius: var(--radius);
}

.guide-title {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 28rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.guide-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-strong);
  color: var(--muted);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
  margin-top: 2rpx;
}

.guide-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

.hint {
  margin-top: 40rpx;
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}

.actions {
  padding: 24rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  margin: 0;
}

.home-btn {
  background: var(--paper);
}
