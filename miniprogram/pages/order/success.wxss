.page {
  min-height: 100vh;
  padding: 54rpx 32rpx 52rpx;
}

.success-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx 42rpx;
  text-align: center;
}

.success-mark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
}

.success-mark__ring {
  position: absolute;
  inset: 0;
  border: 3rpx solid rgba(45, 112, 88, 0.24);
  border-radius: 50%;
  background: rgba(233, 243, 238, 0.82);
  box-shadow: 0 16rpx 38rpx rgba(45, 112, 88, 0.12);
}

.success-mark__ring::before,
.success-mark__ring::after {
  position: absolute;
  border-radius: 50%;
  background: rgba(45, 112, 88, 0.18);
  content: '';
}

.success-mark__ring::before {
  top: -16rpx;
  right: 8rpx;
  width: 18rpx;
  height: 18rpx;
}

.success-mark__ring::after {
  bottom: 2rpx;
  left: -18rpx;
  width: 12rpx;
  height: 12rpx;
}

.success-mark__check {
  position: relative;
  z-index: 1;
  color: var(--brand-success);
  font-size: 58rpx;
  font-weight: 650;
  line-height: 1;
}

.success-kicker,
.title,
.order-no,
.amount-label,
.amount,
.guide-title,
.guide-item__title,
.guide-text,
.notice-text {
  display: block;
}

.success-kicker {
  margin-top: 26rpx;
  color: var(--brand-success);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  margin-top: 12rpx;
  color: var(--brand-ink);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.order-no {
  max-width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  color: var(--brand-muted);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-chip {
  margin-top: 24rpx;
  padding: 14rpx 28rpx;
  border: 2rpx solid rgba(122, 40, 79, 0.1);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.amount-label {
  color: var(--brand-muted);
  font-size: 18rpx;
}

.amount {
  margin-top: 1rpx;
  color: var(--brand-plum);
  font-size: 34rpx;
  font-weight: 650;
}

.guide-card {
  padding: 30rpx;
}

.guide-head {
  margin-bottom: 28rpx;
}

.guide-title {
  margin-top: 5rpx;
  color: var(--brand-ink);
  font-size: 31rpx;
  font-weight: 600;
}

.guide-item {
  display: flex;
  min-height: 96rpx;
}

.guide-item:last-child {
  min-height: auto;
}

.guide-rail {
  position: relative;
  width: 58rpx;
  flex-shrink: 0;
}

.guide-rail::after {
  position: absolute;
  top: 44rpx;
  bottom: 0;
  left: 19rpx;
  width: 2rpx;
  background: var(--brand-line);
  content: '';
}

.guide-item:last-child .guide-rail::after {
  display: none;
}

.guide-num {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: 0 0 0 2rpx var(--brand-line);
}

.guide-copy {
  flex: 1;
  min-width: 0;
  padding-bottom: 24rpx;
}

.guide-item__title {
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 650;
}

.guide-text {
  margin-top: 5rpx;
  color: var(--brand-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(122, 40, 79, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 240, 244, 0.72);
}

.notice-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(122, 40, 79, 0.28);
  border-radius: 50%;
  color: var(--brand-plum);
  font-family: serif;
  font-size: 21rpx;
  font-weight: 700;
}

.notice-text {
  flex: 1;
  color: var(--brand-ink-soft);
  font-size: 22rpx;
  line-height: 1.55;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 4rpx 0;
}

.action-btn {
  width: 100%;
  margin: 0;
}
