.page {
  min-height: 100vh;
  min-height: 100dvh;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}

.page--success {
  display: flex;
  flex-direction: column;
}

.result-status,
.result-title,
.result-subtitle,
.receipt-label,
.receipt-amount,
.receipt-number,
.section-title,
.section-current,
.flow-title,
.flow-text,
.flow-state,
.context-note__text {
  display: block;
}

.result-card {
  padding: 36rpx;
  border-color: var(--brand-line);
  border-radius: var(--brand-radius-card);
  box-shadow: 0 16rpx 42rpx rgba(32, 33, 38, 0.07);
  animation: result-enter 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.result-copy {
  flex: 1;
  min-width: 0;
}

.result-status {
  color: var(--brand-success);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.result-title {
  margin-top: 8rpx;
  color: var(--brand-ink);
  font-size: 50rpx;
  font-weight: 720;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.result-subtitle {
  max-width: 450rpx;
  margin-top: 16rpx;
  color: var(--brand-ink-soft);
  font-size: 24rpx;
  line-height: 1.55;
}

.result-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: var(--brand-success);
  box-shadow: 0 12rpx 28rpx rgba(45, 112, 88, 0.2);
  animation: mark-enter 200ms 60ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.receipt {
  margin-top: 32rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid var(--brand-line);
}

.receipt-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.receipt-row--number {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--brand-line);
}

.receipt-label {
  flex-shrink: 0;
  color: var(--brand-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.receipt-amount {
  color: var(--brand-plum);
  font-size: 56rpx;
  font-weight: 740;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  text-align: right;
}

.receipt-number {
  max-width: 480rpx;
  color: var(--brand-ink-soft);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.flow-section {
  margin-top: 34rpx;
  animation: content-enter 220ms 70ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 4rpx 16rpx;
}

.section-title {
  color: var(--brand-ink);
  font-size: 32rpx;
  font-weight: 680;
}

.section-current {
  flex-shrink: 0;
  color: var(--brand-plum);
  font-size: 21rpx;
  font-weight: 600;
}

.flow-list {
  border-top: 2rpx solid var(--brand-line-strong);
  border-bottom: 2rpx solid var(--brand-line-strong);
}

.flow-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx solid var(--brand-line);
}

.flow-item:last-child {
  border-bottom: 0;
}

.flow-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--brand-line);
  border-radius: var(--brand-radius-control);
  background: #FFFFFF;
}

.flow-icon--done {
  border-color: var(--brand-success);
  background: var(--brand-success);
}

.flow-icon--current {
  border-color: rgba(122, 40, 79, 0.18);
  background: var(--brand-pink-soft);
}

.flow-copy {
  flex: 1;
  min-width: 0;
}

.flow-title {
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 650;
}

.flow-text {
  margin-top: 5rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
  line-height: 1.45;
}

.flow-state {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 650;
}

.flow-state--done {
  background: var(--sage);
  color: var(--brand-success);
}

.flow-state--current {
  background: var(--brand-pink-soft);
  color: var(--brand-plum);
}

.context-note {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 26rpx;
  padding: 18rpx 4rpx 18rpx 20rpx;
  border-left: 4rpx solid var(--brand-plum);
}

.context-note__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.context-note__text {
  flex: 1;
  color: var(--brand-ink-soft);
  font-size: 22rpx;
  line-height: 1.55;
}

.actions {
  display: flex;
  gap: 14rpx;
  width: 100%;
  margin-top: auto;
  padding-top: 38rpx;
}

.action-btn {
  min-height: 88rpx;
  margin: 0;
  white-space: nowrap;
}

.action-btn--secondary {
  flex: 0.72;
}

.action-btn--primary {
  flex: 1.28;
}

@keyframes result-enter {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes content-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes mark-enter {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .result-card,
  .result-mark,
  .flow-section {
    animation: none;
  }
}
