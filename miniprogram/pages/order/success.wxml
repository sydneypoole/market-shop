<view class="page">
  <view class="main">
    <view class="check-circle">
      <text class="check-mark">✓</text>
    </view>
    <text class="title serif">订单已提交</text>
    <text class="order-no" wx:if="{{orderNo}}">订单号 {{orderNo}}</text>

    <view class="guide-card">
      <text class="guide-title">线下转账指引</text>
      <view class="guide-list">
        <view class="guide-item">
          <view class="guide-num">1</view>
          <text class="guide-text">联系你的直属上级获取收款方式</text>
        </view>
        <view class="guide-item">
          <view class="guide-num">2</view>
          <text class="guide-text">按订单金额 ¥{{totalText}} 完成线下转账</text>
        </view>
        <view class="guide-item">
          <view class="guide-num">3</view>
          <text class="guide-text">回到订单详情上传付款凭证，等待确认</text>
        </view>
      </view>
    </view>

    <text class="hint">上级确认收款后订单进入后台审核，可在「我的-我的订单」查看进度</text>
  </view>

  <view class="actions">
    <button class="btn-primary action-btn" bindtap="goOrderDetail">查看订单</button>
    <button class="btn-outline action-btn home-btn" bindtap="goHome">返回首页</button>
  </view>
</view>
