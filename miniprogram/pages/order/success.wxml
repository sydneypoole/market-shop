<brand-shell
  tone="hero"
  aria-label="{{valid ? '订单提交成功' : '订单信息无效'}}"
  safe-bottom
>
  <view class="page">
    <block wx:if="{{valid}}">
    <view class="success-hero">
      <view class="success-mark" aria-hidden="true">
        <view class="success-mark__ring"></view>
        <text class="success-mark__check">✓</text>
      </view>
      <text class="success-kicker">订单提交成功</text>
      <text class="title serif">订单已进入确认流程</text>
      <text class="order-no" wx:if="{{orderNo}}">订单号 {{orderNo}}</text>
      <view class="amount-chip">
        <text class="amount-label">订单金额</text>
        <text class="amount serif">¥{{totalText}}</text>
      </view>
    </view>

    <view class="guide-card surface">
      <view class="guide-head">
        <text class="section-eyebrow">线下转账指引</text>
        <text class="guide-title serif">接下来这样操作</text>
      </view>
      <view class="guide-list">
        <view class="guide-item">
          <view class="guide-rail">
            <view class="guide-num">1</view>
          </view>
          <view class="guide-copy">
            <text class="guide-item__title">联系直属上级</text>
            <text class="guide-text">获取线下收款方式</text>
          </view>
        </view>
        <view class="guide-item">
          <view class="guide-rail">
            <view class="guide-num">2</view>
          </view>
          <view class="guide-copy">
            <text class="guide-item__title">完成线下转账</text>
            <text class="guide-text">按订单金额 ¥{{totalText}} 进行转账</text>
          </view>
        </view>
        <view class="guide-item">
          <view class="guide-rail">
            <view class="guide-num">3</view>
          </view>
          <view class="guide-copy">
            <text class="guide-item__title">上传付款凭证</text>
            <text class="guide-text">回到订单详情上传凭证并等待确认</text>
          </view>
        </view>
      </view>
    </view>

    <view class="notice-card">
      <view class="notice-mark" aria-hidden="true">提</view>
      <text class="notice-text">上级确认收款后订单进入后台审核，可在「我的订单」查看进度</text>
    </view>

    <view class="actions">
      <button class="btn-primary action-btn" bindtap="goOrderDetail">查看订单</button>
      <button class="btn-outline action-btn" bindtap="goHome">返回首页</button>
    </view>
    </block>

    <empty
      wx:else
      text="{{error || '订单提交信息无效'}}"
      hint="请返回首页重新选购"
      buttonText="返回首页"
      bind:action="goHome"
    />
  </view>
</brand-shell>
