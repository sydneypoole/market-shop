<view class="page">
  <scroll-view class="tabs" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state">加载中…</view>

  <block wx:elif="{{displayList.length}}">
    <view
      wx:for="{{displayList}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="card-head">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <text class="status tone-{{item.tone}}">{{item.statusText}}</text>
      </view>

      <view class="card-body">
        <view class="amount-row">
          <text class="amount-label">订单金额</text>
          <text class="price serif">¥{{item.amountText}}</text>
        </view>
        <text class="time">{{item.createdText}}</text>
      </view>

      <view class="card-foot" catchtap="noop">
        <text class="count">合计 ¥{{item.amountText}}</text>
        <view class="actions">
          <button class="btn-outline action" size="mini" data-id="{{item.id}}" catchtap="goDetail">查看详情</button>
          <button wx:if="{{item.actions.canCancel}}" class="btn-outline action" size="mini" data-id="{{item.id}}" catchtap="onCancel">取消订单</button>
          <button wx:if="{{item.actions.canUploadProof}}" class="btn-primary action" size="mini" data-id="{{item.id}}" catchtap="onUploadProof">上传凭证</button>
          <button wx:if="{{item.actions.canReceive}}" class="btn-primary action" size="mini" data-id="{{item.id}}" catchtap="onReceive">确认收货</button>
        </view>
      </view>
    </view>
  </block>

  <empty
    wx:else
    text="还没有订单"
    hint="提交的第一笔订单会显示在这里"
    buttonText="返回首页"
    bind:action="goHome"
  />
</view>
