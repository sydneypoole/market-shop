<brand-shell
  loading="{{loading}}"
  loading-text="正在读取订单"
  tone="quiet"
  aria-label="我的订单列表"
  safe-bottom
>
  <view class="page">
    <view class="page-intro">
      <text class="page-title">我的订单</text>
      <text class="page-subtitle">按状态查看订单，并处理当前可执行操作</text>
    </view>

    <scroll-view class="tabs-wrap" scroll-x enable-flex show-scrollbar="{{false}}" aria-label="订单状态分类">
      <view class="tabs">
        <button
          wx:for="{{tabs}}"
          wx:key="key"
          class="tab {{activeTab === index ? 'tab--active' : ''}}"
          data-index="{{index}}"
          bindtap="onTabChange"
          aria-selected="{{activeTab === index}}"
        >{{item.label}}</button>
      </view>
    </scroll-view>

    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      bind:action="loadOrders"
    />

    <view wx:elif="{{!loading && displayList.length}}" class="order-list">
      <view
        wx:for="{{displayList}}"
        wx:key="id"
        class="order-card surface"
        data-id="{{item.id}}"
        bindtap="goDetail"
        aria-role="button"
        aria-label="订单 {{item.orderNo}}，{{item.statusText}}，金额 {{item.amountText}} 元"
      >
        <view class="card-head">
          <view class="order-icon" aria-hidden="true">
            <fui-icon name="order" size="32" color="#7A284F" disabled aria-hidden="true" />
          </view>
          <view class="card-identity">
            <text class="card-eyebrow">订单号</text>
            <text class="order-no">{{item.orderNo}}</text>
          </view>
          <fui-tag
            text="{{item.statusText}}"
            background="{{item.tone === 'green' ? '#E9F3EE' : (item.tone === 'gold' ? '#FAEFE1' : (item.tone === 'danger' ? '#FDECEF' : (item.tone === 'coral' ? '#F5EBF0' : '#EFF0F3')))}}"
            border-color="{{item.tone === 'green' ? '#CFE2D8' : (item.tone === 'gold' ? '#EED8BC' : (item.tone === 'danger' ? '#EFC9D1' : (item.tone === 'coral' ? '#F0CFDB' : '#D2D5DC')))}}"
            color="{{item.tone === 'green' ? '#2D7058' : (item.tone === 'gold' ? '#A3682D' : (item.tone === 'danger' ? '#B73F59' : (item.tone === 'coral' ? '#7A284F' : '#6F656B')))}}"
            size="21"
            radius="22"
            padding="8rpx 16rpx"
          />
        </view>

        <view class="card-summary">
          <view>
            <text class="summary-label">订单金额</text>
            <text class="amount">¥{{item.amountText}}</text>
          </view>
          <view class="summary-time">
            <text class="summary-label">提交时间</text>
            <text class="time">{{item.createdText}}</text>
          </view>
        </view>

        <view class="card-foot" catchtap="noop">
          <button
            class="detail-action"
            data-id="{{item.id}}"
            catchtap="goDetail"
            aria-label="查看订单详情"
          >查看详情</button>
          <view class="actions">
            <button
              wx:if="{{item.actions.canCancel}}"
              class="btn-outline action"
              data-id="{{item.id}}"
              disabled="{{actionPendingId > 0}}"
              catchtap="onCancel"
            >取消订单</button>
            <button
              wx:if="{{item.actions.canUploadProof}}"
              class="btn-primary action"
              data-id="{{item.id}}"
              disabled="{{actionPendingId > 0}}"
              catchtap="onUploadProof"
            >上传凭证</button>
            <button
              wx:if="{{item.actions.canReceive}}"
              class="btn-primary action"
              data-id="{{item.id}}"
              loading="{{actionPendingId == item.id}}"
              disabled="{{actionPendingId > 0}}"
              catchtap="onReceive"
            >确认收货</button>
          </view>
        </view>
      </view>
    </view>

    <empty
      wx:elif="{{!loading}}"
      text="还没有订单"
      hint="当前分类暂无订单，去首页看看商品"
      buttonText="返回首页"
      bind:action="goHome"
    />
  </view>
</brand-shell>
