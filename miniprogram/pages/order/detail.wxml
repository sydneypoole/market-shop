<brand-shell
  loading="{{loading}}"
  loading-text="正在读取订单详情"
  tone="quiet"
  aria-label="订单详情"
  safe-bottom
>
  <view wx:if="{{!loading && order}}" class="page {{actions.canCancel || actions.canUploadProof || actions.canReceive ? 'page--with-footer' : ''}}">
    <view class="status-card surface">
      <view class="status-topline">
        <fui-tag
          text="{{statusTitle}}"
          background="{{order.status === 'SHIPPED' || order.status === 'COMPLETED' ? '#E9F3EE' : (order.status === 'PENDING_SHIPMENT' ? '#FAEFE1' : (order.status === 'SUPERIOR_REJECTED' || order.status === 'ADMIN_REJECTED' || order.status === 'CANCELLED' ? '#FDECEF' : (order.status === 'PENDING_SUPERIOR' || order.status === 'PENDING_ADMIN_REVIEW' ? '#F5EBF0' : '#EFF0F3')))}}"
          border-color="{{order.status === 'SHIPPED' || order.status === 'COMPLETED' ? '#CFE2D8' : (order.status === 'PENDING_SHIPMENT' ? '#EED8BC' : (order.status === 'SUPERIOR_REJECTED' || order.status === 'ADMIN_REJECTED' || order.status === 'CANCELLED' ? '#EFC9D1' : (order.status === 'PENDING_SUPERIOR' || order.status === 'PENDING_ADMIN_REVIEW' ? '#F0CFDB' : '#D2D5DC')))}}"
          color="{{order.status === 'SHIPPED' || order.status === 'COMPLETED' ? '#2D7058' : (order.status === 'PENDING_SHIPMENT' ? '#A3682D' : (order.status === 'SUPERIOR_REJECTED' || order.status === 'ADMIN_REJECTED' || order.status === 'CANCELLED' ? '#B73F59' : (order.status === 'PENDING_SUPERIOR' || order.status === 'PENDING_ADMIN_REVIEW' ? '#7A284F' : '#6F656B')))}}"
          size="22"
          radius="22"
          padding="9rpx 18rpx"
        />
        <text class="status-caption">订单状态</text>
      </view>
      <text class="status-title">{{statusTitle}}</text>
      <text class="status-hint">{{statusHint}}</text>
      <view class="status-meta">
        <view class="status-meta__item">
          <text class="meta-label">订单号</text>
          <text class="meta-value">{{order.orderNo}}</text>
        </view>
        <view class="status-meta__item status-meta__item--right">
          <text class="meta-label">订单金额</text>
          <text class="meta-amount">¥{{totalAmountText}}</text>
        </view>
      </view>
    </view>

    <view class="decision-card surface" wx:if="{{actions.canSuperiorDecide}}">
      <view class="decision-mark" aria-hidden="true">
        <fui-icon name="wait" size="38" color="#A3682D" disabled aria-hidden="true" />
      </view>
      <view class="decision-copy">
        <text class="decision-title">等待你确认线下收款</text>
        <text class="decision-sub">确认后订单进入后台审核；拒绝时需填写原因</text>
      </view>
      <view class="decision-actions">
        <button
          class="btn-outline decision-btn"
          disabled="{{actionPending || pendingUpload}}"
          bindtap="onSuperiorReject"
        >拒绝订单</button>
        <button
          class="btn-primary decision-btn"
          loading="{{actionPending}}"
          disabled="{{actionPending || pendingUpload}}"
          bindtap="onSuperiorApprove"
        >确认收款</button>
      </view>
    </view>

    <view class="proof-card surface" wx:if="{{actions.canUploadProof || proofCount}}">
      <view class="section-head section-head--proof">
        <view>
          <text class="section-title">凭证图片</text>
        </view>
        <text class="proof-count">{{proofCount}} / {{maxProofFiles}}</text>
      </view>
      <text wx:if="{{maxProofFiles}}" class="proof-rule">
        支持 JPG / PNG / WebP，最多 {{maxProofFiles}} 张，单张不超过 {{maxProofSizeText}}
      </text>
      <text wx:if="{{proofLoading}}" class="proof-rule">正在刷新凭证…</text>

      <button wx:if="{{proofError}}" class="proof-error" bindtap="retryProofs">
        <text>{{proofError}}</text>
        <text class="proof-error__action">刷新凭证</text>
      </button>

      <view class="proof-list">
        <block wx:for="{{proofPreviews}}" wx:key="proofId">
          <image
            wx:if="{{item.url}}"
            class="proof-thumb"
            src="{{item.url}}"
            mode="aspectFill"
            data-url="{{item.url}}"
            bindtap="previewProof"
            aria-role="button"
            aria-label="查看第 {{index + 1}} 张付款凭证"
          />
          <view wx:else class="proof-thumb proof-placeholder" aria-label="凭证预览暂不可用">
            <fui-icon name="warning" size="32" color="#B73F59" disabled aria-hidden="true" />
            <text>预览待刷新</text>
          </view>
        </block>
        <button
          wx:if="{{actions.canUploadProof && proofCount < maxProofFiles}}"
          class="proof-add"
          disabled="{{pendingUpload || actionPending || proofLoading}}"
          bindtap="onUploadProof"
          aria-label="上传付款凭证"
        >
          <fui-icon name="picture" size="40" color="#7A284F" disabled aria-hidden="true" />
          <text class="proof-add__text">{{pendingUpload ? '上传中' : '添加凭证'}}</text>
        </button>
      </view>
    </view>

    <view class="detail-card surface" wx:if="{{address}}">
      <view class="section-head">
        <view>
          <text class="section-title">收货地址</text>
        </view>
      </view>
      <view class="address-line">
        <text class="address-name">{{address.recipientName}}</text>
        <text class="address-phone">{{address.phoneMasked}}</text>
      </view>
      <text class="address-detail">{{address.fullAddress}}</text>
    </view>

    <view class="detail-card surface">
      <view class="section-head">
        <view>
          <text class="section-title">订单商品</text>
        </view>
        <text class="section-count">{{items.length}} 项</text>
      </view>
      <view class="goods-list">
        <view class="goods-row" wx:for="{{items}}" wx:key="skuId">
          <image
            wx:if="{{item.coverUrl}}"
            class="goods-cover"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            aria-label="{{item.productName}} 商品图"
          />
          <view wx:else class="goods-cover goods-cover--placeholder" aria-hidden="true">
            <fui-icon name="picture" size="36" color="#6F656B" disabled aria-hidden="true" />
          </view>
          <view class="goods-meta">
            <text class="goods-name">{{item.productName}}</text>
            <text wx:if="{{item.skuName}}" class="goods-sku">{{item.skuName}}</text>
            <view class="goods-bottom">
              <text class="goods-qty">数量 × {{item.quantity}}</text>
              <text class="goods-price">¥{{item.priceText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <button
      wx:if="{{canApplyAftersale}}"
      class="aftersale-entry surface"
      bindtap="goAftersaleApply"
      aria-label="为当前订单申请售后"
    >
      <view>
        <text class="entry-label">售后服务</text>
        <text class="entry-title">申请退款或退货退款</text>
      </view>
      <fui-icon class="entry-chevron" name="arrowright" size="30" color="#7A284F" disabled aria-hidden="true" />
    </button>

    <view class="detail-card surface">
      <view class="section-head">
        <view>
          <text class="section-title">金额与备注</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">商品金额</text>
        <text class="info-value">¥{{goodsAmountText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">运费</text>
        <text class="info-value">¥0.00</text>
      </view>
      <view class="info-row">
        <text class="info-label">结算方式</text>
        <text class="info-value">线下转账</text>
      </view>
      <view class="info-row" wx:if="{{buyerNote}}">
        <text class="info-label">订单备注</text>
        <text class="info-value info-value--wrap">{{buyerNote}}</text>
      </view>
      <view class="info-row" wx:if="{{order.reason}}">
        <text class="info-label">状态原因</text>
        <text class="info-value info-value--danger">{{order.reason}}</text>
      </view>
      <view class="info-row info-row--total">
        <text class="info-label info-label--total">订单合计</text>
        <text class="info-total">¥{{totalAmountText}}</text>
      </view>
    </view>

    <view class="detail-card surface">
      <view class="section-head">
        <view>
          <text class="section-title">流转记录</text>
        </view>
      </view>
      <view class="timeline">
        <view wx:for="{{timeline}}" wx:key="key" class="timeline-item timeline-item--{{item.state}}">
          <view class="timeline-rail" aria-hidden="true">
            <view class="timeline-dot"></view>
          </view>
          <view class="timeline-body">
            <text class="timeline-label">{{item.label}}</text>
            <text wx:if="{{item.time}}" class="timeline-note">{{item.time}}</text>
            <text wx:elif="{{item.hint}}" class="timeline-note timeline-note--current">{{item.hint}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="footer" wx:if="{{actions.canCancel || actions.canUploadProof || actions.canReceive}}">
      <button
        wx:if="{{actions.canCancel}}"
        class="btn-outline footer-btn"
        disabled="{{actionPending || pendingUpload}}"
        bindtap="onCancel"
      >取消订单</button>
      <button
        wx:if="{{actions.canUploadProof}}"
        class="btn-primary footer-btn footer-btn--primary"
        disabled="{{pendingUpload || actionPending || proofLoading || !maxProofFiles || proofCount >= maxProofFiles}}"
        bindtap="onUploadProof"
      >{{pendingUpload ? '上传中' : '上传凭证'}}</button>
      <button
        wx:if="{{actions.canReceive}}"
        class="btn-primary footer-btn footer-btn--primary"
        loading="{{actionPending}}"
        disabled="{{actionPending || pendingUpload}}"
        bindtap="onReceive"
      >确认收货</button>
    </view>
  </view>

  <empty
    wx:elif="{{!loading}}"
    text="{{error || '订单不存在'}}"
    hint="请确认订单后重试"
    buttonText="重新加载"
    bind:action="loadDetail"
  />
</brand-shell>
