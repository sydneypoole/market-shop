<brand-shell
  loading="{{loading}}"
  loading-text="正在准备结算信息"
  tone="quiet"
  aria-label="确认订单"
  safe-bottom
>
  <view class="page {{!loading && !loadError ? 'page--with-footer' : ''}}">
    <view class="page-intro">
      <view>
        <text class="page-title">确认订单</text>
        <text class="page-subtitle">核对收货信息与商品明细后提交</text>
      </view>
      <fui-tag
        text="线下结算"
        background="#F5EBF0"
        border-color="#F0CFDB"
        color="#7A284F"
        size="20"
        radius="20"
        padding="7rpx 14rpx"
      />
    </view>

    <empty
      wx:if="{{!loading && loadError}}"
      text="{{loadError}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      bind:action="bootstrap"
    />

    <block wx:elif="{{!loading}}">
      <button class="address-card surface" bindtap="onSelectAddress" aria-label="选择收货地址">
        <view class="address-icon" aria-hidden="true">
          <fui-icon name="location" size="38" color="#7A284F" disabled aria-hidden="true" />
        </view>
        <view class="address-body" wx:if="{{address}}">
          <view class="address-top">
            <text class="address-name">{{address.recipientName}}</text>
            <text class="address-phone">{{addressPhoneMasked}}</text>
          </view>
          <text class="address-detail">{{addressFull}}</text>
        </view>
        <view class="address-body address-body--empty" wx:else>
          <text class="address-placeholder">请选择收货地址</text>
          <text class="address-helper">提交订单前需要完整的收件信息</text>
        </view>
        <fui-icon class="address-chevron" name="arrowright" size="30" color="#7A284F" disabled aria-hidden="true" />
      </button>

      <view class="section-card surface">
        <view class="section-head">
          <view>
            <text class="section-title">商品明细</text>
          </view>
          <text class="section-count">{{goods.length}} 项</text>
        </view>

        <view wx:if="{{goods.length}}" class="goods-list">
          <view class="goods-row" wx:for="{{goods}}" wx:key="skuId">
            <image
              wx:if="{{item.coverUrl}}"
              class="goods-cover"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              aria-label="{{item.productName}} 商品图"
            />
            <view wx:else class="goods-cover goods-cover--placeholder" aria-hidden="true">
              <fui-icon name="picture" size="36" color="#6F656B" disabled aria-hidden="true" />
            </view>
            <view class="goods-meta">
              <text class="goods-name">{{item.displayName}}</text>
              <text class="goods-qty">数量 × {{item.quantity}}</text>
            </view>
            <text class="goods-price">¥{{item.priceText}}</text>
          </view>
        </view>
        <empty wx:else text="暂无可结算商品" hint="请返回购物车重新选择" />
      </view>

      <view class="section-card surface">
        <view class="section-head">
          <view>
            <text class="section-title">订单金额</text>
          </view>
        </view>
        <view class="amount-row">
          <text class="amount-label">商品金额</text>
          <text class="amount-value">¥{{goodsAmountText}}</text>
        </view>
        <view class="amount-row">
          <text class="amount-label">运费</text>
          <text class="amount-value">¥0.00</text>
        </view>
        <view class="amount-row amount-row--total">
          <text class="amount-label amount-label--total">应付合计</text>
          <text class="amount-total">¥{{totalText}}</text>
        </view>
      </view>

      <view class="section-card surface remark-card">
        <view class="remark-copy">
          <text class="section-title">订单备注</text>
          <text class="remark-hint">选填，最多 500 字</text>
        </view>
        <input
          class="remark-input"
          type="text"
          maxlength="500"
          placeholder="给订单补充说明"
          placeholder-class="remark-placeholder"
          value="{{remark}}"
          bindinput="onRemarkInput"
          aria-label="订单备注，选填"
        />
      </view>

      <view class="flow-note">
        <view class="flow-note__mark" aria-hidden="true">
          <fui-icon name="info" size="32" color="#7A284F" disabled aria-hidden="true" />
        </view>
        <text class="flow-note__text">提交后由直属上级确认线下收款，再经后台审核发货</text>
      </view>

      <view class="footer">
        <view class="footer-total">
          <text class="footer-label">应付合计</text>
          <text class="footer-price">¥{{totalText}}</text>
        </view>
        <button
          class="btn-primary submit-btn"
          loading="{{submitting}}"
          disabled="{{submitting || loading || !address || !goods.length || hasUnavailableGoods}}"
          bindtap="onSubmit"
          aria-label="提交订单"
        >{{submitting ? '正在提交' : '提交订单'}}</button>
      </view>
    </block>
  </view>
</brand-shell>
