<brand-shell
  loading="{{loading}}"
  loading-text="正在读取待确认订单"
  tone="quiet"
  aria-label="上级待确认订单"
  safe-bottom
>
  <view class="page">
    <view class="page-intro">
      <text class="page-title">上级订单</text>
      <text class="page-subtitle">核对直推会员的订单与线下收款情况</text>
    </view>

    <view class="notice-card">
      <view class="notice-mark" aria-hidden="true">
        <fui-icon name="wait" size="34" color="#A3682D" disabled aria-hidden="true" />
      </view>
      <view class="notice-copy">
        <text class="notice-title">以下订单等待确认</text>
        <text class="notice-text">进入详情后可确认线下收款，或填写原因拒绝订单</text>
      </view>
    </view>

    <empty
      wx:if="{{!loading && error}}"
      text="{{error}}"
      hint="请检查网络后重试"
      buttonText="重新加载"
      bind:action="loadOrders"
    />

    <view wx:elif="{{!loading && orders.length}}" class="order-list">
      <view
        wx:for="{{orders}}"
        wx:key="id"
        class="order-card surface"
        data-id="{{item.id}}"
        bindtap="goDetail"
        aria-role="button"
        aria-label="订单 {{item.orderNo}}，{{item.statusText}}，金额 {{item.amountText}} 元"
      >
        <view class="card-head">
          <view class="order-icon" aria-hidden="true">
            <fui-icon name="order" size="32" color="#7A284F" disabled aria-hidden="true" />
          </view>
          <view class="card-identity">
            <text class="card-eyebrow">订单号</text>
            <text class="order-no">{{item.orderNo}}</text>
          </view>
          <fui-tag
            text="{{item.statusText}}"
            background="{{item.tone === 'green' ? '#E9F3EE' : (item.tone === 'gold' ? '#FAEFE1' : (item.tone === 'danger' ? '#FDECEF' : (item.tone === 'coral' ? '#F5EBF0' : '#EFF0F3')))}}"
            border-color="{{item.tone === 'green' ? '#CFE2D8' : (item.tone === 'gold' ? '#EED8BC' : (item.tone === 'danger' ? '#EFC9D1' : (item.tone === 'coral' ? '#F0CFDB' : '#D2D5DC')))}}"
            color="{{item.tone === 'green' ? '#2D7058' : (item.tone === 'gold' ? '#A3682D' : (item.tone === 'danger' ? '#B73F59' : (item.tone === 'coral' ? '#7A284F' : '#6F656B')))}}"
            size="21"
            radius="22"
            padding="8rpx 16rpx"
          />
        </view>

        <view class="card-summary">
          <view>
            <text class="summary-label">订单金额</text>
            <text class="amount">¥{{item.amountText}}</text>
          </view>
          <view class="summary-time">
            <text class="summary-label">提交时间</text>
            <text class="time">{{item.createdText}}</text>
          </view>
        </view>

        <view class="card-foot">
          <text class="detail-label">进入详情核对并处理</text>
          <fui-icon class="detail-chevron" name="arrowright" size="30" color="#7A284F" disabled aria-hidden="true" />
        </view>
      </view>
    </view>

    <empty
      wx:elif="{{!loading}}"
      text="暂无待处理订单"
      hint="直推会员提交且需要你确认的订单会显示在这里"
    />
  </view>
</brand-shell>
