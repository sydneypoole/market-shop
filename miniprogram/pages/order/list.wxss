.page {
  min-height: 100vh;
  padding: 36rpx 24rpx 52rpx;
}

.page-intro {
  padding: 10rpx 12rpx 26rpx;
}

.page-title,
.page-subtitle,
.card-eyebrow,
.order-no,
.summary-label,
.amount,
.time {
  display: block;
}

.page-title {
  margin-top: 10rpx;
  color: var(--brand-ink);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
}

.tabs-wrap {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tabs {
  display: inline-flex;
  min-width: 100%;
  padding: 6rpx;
  border: 2rpx solid rgba(234, 221, 226, 0.88);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: var(--brand-shadow-soft);
}

.tab {
  min-width: 132rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: var(--brand-muted);
  font-size: 25rpx;
  line-height: 72rpx;
}

.tab::after {
  border: 0;
}

.tab--active {
  background: linear-gradient(135deg, var(--brand-plum-deep), var(--brand-plum));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(122, 40, 79, 0.18);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
}

.order-card:active {
  border-color: rgba(122, 40, 79, 0.34);
}

.card-head,
.card-summary,
.card-foot,
.actions {
  display: flex;
  align-items: center;
}

.card-head,
.card-summary,
.card-foot {
  justify-content: space-between;
  gap: 20rpx;
}

.card-identity {
  flex: 1;
  min-width: 0;
}

.card-eyebrow,
.summary-label {
  color: var(--brand-muted);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.order-no {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--brand-ink-soft);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-summary {
  align-items: flex-end;
  margin-top: 24rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid rgba(234, 221, 226, 0.74);
  border-bottom: 2rpx solid rgba(234, 221, 226, 0.74);
}

.amount {
  margin-top: 4rpx;
  color: var(--brand-plum);
  font-size: 34rpx;
  font-weight: 650;
}

.summary-time {
  text-align: right;
}

.time {
  margin-top: 6rpx;
  color: var(--brand-ink-soft);
  font-size: 21rpx;
}

.card-foot {
  align-items: center;
  padding-top: 20rpx;
}

.detail-action {
  min-height: 62rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--brand-muted);
  font-size: 22rpx;
  line-height: 62rpx;
}

.detail-action::after {
  border: 0;
}

.actions {
  flex: 1;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.action {
  min-width: 142rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 23rpx;
}

@media (max-width: 360px) {
  .card-foot {
    align-items: flex-end;
    flex-direction: column;
  }

  .detail-action {
    align-self: flex-start;
  }

  .actions {
    width: 100%;
  }
}
