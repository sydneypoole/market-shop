<brand-shell
  loading="{{loading}}"
  loading-text="正在登录"
  tone="hero"
  aria-label="宏杉生物会员登录"
>
  <view class="page">
    <view class="custom-nav" style="padding-top: {{navigation.statusBarHeight}}px" aria-label="会员登录导航">
      <view class="custom-nav-bar" style="height: {{navigation.navigationBarHeight}}px">
        <button
          class="nav-home"
          style="width: {{navigation.sideWidth}}px"
          disabled="{{loading}}"
          bindtap="goHome"
          aria-label="返回商城首页"
        >
          <fui-icon name="home" size="30" color="#7A284F" disabled aria-hidden="true" />
          <text>返回首页</text>
        </button>
        <text class="nav-title">会员登录</text>
        <view class="nav-balance" style="width: {{navigation.sideWidth}}px" aria-hidden="true"></view>
      </view>
    </view>

    <view class="brand-hero">
      <view class="brand-copy">
        <text class="brand-name">宏杉生物会员</text>
        <text class="brand-subtitle">使用已绑定的微信身份继续访问商城</text>
      </view>
      <view class="logo-wrap">
        <image
          class="brand-logo"
          src="/assets/brand/logo.png"
          mode="aspectFit"
          aria-role="img"
          aria-label="宏杉生物品牌标志"
        />
      </view>
    </view>

    <view class="auth-card surface">
      <view class="card-head">
        <view class="card-icon" aria-hidden="true">
          <fui-icon name="wechat" size="36" color="#7A284F" disabled aria-hidden="true" />
        </view>
        <view class="card-copy">
          <text class="card-title">欢迎回来</text>
        </view>
      </view>

      <view wx:if="{{error}}" class="auth-error" aria-live="assertive">
        <fui-icon name="info" size="28" color="#B73F59" disabled aria-hidden="true" />
        <text>{{error}}</text>
      </view>

      <button
        class="btn-primary auth-button"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="onLogin"
      >
        <fui-icon wx:if="{{!loading}}" name="wechat" size="36" color="#FFFFFF" disabled aria-hidden="true" />
        <text>{{loading ? '登录中…' : '微信一键登录'}}</text>
      </button>

      <view class="auth-switch">
        <text>还没有会员账号？</text>
        <button
          class="text-action"
          disabled="{{loading}}"
          bindtap="goRegister"
          aria-label="前往会员注册"
        >立即注册</button>
      </view>
    </view>
  </view>
</brand-shell>
