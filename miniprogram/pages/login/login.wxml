<view class="page">
  <view class="main">
    <image
      class="brand-logo"
      src="/assets/brand/logo.png"
      mode="aspectFit"
      aria-role="img"
      aria-label="宏杉生物 Logo"
    />
    <text class="subtitle">邀请制会员商城 · 线下甄选</text>
    <view class="divider"></view>

    <button class="btn-primary login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">
      微信一键登录
    </button>

    <input
      wx:if="{{credentialMode === 'invite'}}"
      class="invite-input"
      type="text"
      maxlength="32"
      placeholder="请输入邀请码（首次注册必填）"
      placeholder-class="invite-placeholder"
      value="{{inviteCode}}"
      bindinput="onInviteInput"
    />
    <input
      wx:else
      class="invite-input"
      type="text"
      password="{{true}}"
      maxlength="128"
      placeholder="请输入一次性发起人认领密钥"
      placeholder-class="invite-placeholder"
      value="{{sponsorClaimSecret}}"
      bindinput="onSponsorClaimInput"
    />
    <view class="credential-help">
      <text class="invite-hint">{{credentialMode === 'invite' ? '已有账号登录无需邀请码' : '认领密钥仅用于首次绑定发起人账号'}}</text>
      <text
        wx:if="{{credentialMode === 'invite'}}"
        class="credential-switch"
        bindtap="useSponsorClaimMode"
      >认领发起人账号</text>
      <text wx:else class="credential-switch" bindtap="useInviteMode">使用邀请码注册</text>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">登录即同意《用户协议》与《隐私政策》 · 积分不可提现、不可转让、不可兑换现金</text>
  </view>
</view>
