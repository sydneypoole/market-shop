.page {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
}

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 112rpx;
}

.brand-logo {
  width: 360rpx;
  height: 360rpx;
  display: block;
  border-radius: 24rpx;
}

.subtitle {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.divider {
  width: 80rpx;
  height: 2rpx;
  background: var(--line-strong);
  margin: 56rpx 0 48rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border-radius: var(--radius);
}

.invite-input {
  width: 100%;
  height: 96rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--ink);
  background: var(--paper);
}

.invite-placeholder {
  color: var(--muted);
}

.invite-hint {
  font-size: 24rpx;
  color: var(--muted);
}

.credential-help {
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.credential-switch {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--green);
}

.footer {
  padding: 32rpx 0 calc(48rpx + env(safe-area-inset-bottom));
}

.footer-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
