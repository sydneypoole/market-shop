.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.search-panel {
  padding: 30rpx 28rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.search-title {
  display: block;
  color: var(--brand-ink);
  font-size: 40rpx;
  font-weight: 700;
}

.search-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--brand-muted);
  font-size: 22rpx;
}

.search-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.search-box {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 82rpx;
  align-items: center;
  padding: 0 18rpx 0 22rpx;
  border: 2rpx solid var(--brand-line-strong);
  border-radius: var(--brand-radius-control);
  background: #FFFFFF;
}

.search-box > fui-icon { flex-shrink: 0; margin-right: 14rpx; }

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  color: var(--brand-ink);
  font-size: 26rpx;
}

.search-placeholder {
  color: #8a8d96;
}

.clear-button {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.search-submit {
  min-width: 120rpx;
  min-height: 88rpx;
  margin: 0 0 0 12rpx;
  padding: 0 22rpx;
  border: none;
  border-radius: var(--brand-radius-control);
  background: var(--brand-plum);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.search-submit::after {
  border: none;
}

.result-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 36rpx 6rpx 22rpx;
}

.result-kicker,
.result-query {
  display: block;
}

.result-kicker {
  color: var(--brand-muted);
  font-size: 22rpx;
}

.result-query {
  max-width: 520rpx;
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--brand-ink);
  font-size: 34rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -9rpx;
}

.product-cell {
  width: 50%;
  padding: 0 9rpx 18rpx;
}

.state-card {
  margin-top: 26rpx;
  overflow: hidden;
}

.search-guide {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 64rpx 42rpx;
  flex-direction: column;
  text-align: center;
}

.guide-mark {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: var(--brand-pink-soft);
}

.guide-title,
.guide-copy {
  display: block;
}

.guide-title {
  margin-top: 26rpx;
  color: var(--brand-ink);
  font-size: 33rpx;
  font-weight: 600;
}

.guide-copy {
  max-width: 540rpx;
  margin-top: 14rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.65;
}
