.page {
  min-height: 100vh;
  background: var(--paper);
}

.search-bar {
  padding: 16rpx 32rpx 8rpx;
  background: var(--paper);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-box {
  height: 72rpx;
  border: 2rpx solid var(--ink);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  padding: 0 20rpx 0 24rpx;
  gap: 12rpx;
  background: var(--paper);
}

.search-icon {
  color: var(--muted);
  font-size: 28rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--muted);
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--line);
  color: var(--muted);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.result {
  padding: 16rpx 24rpx 48rpx;
}

.result-count {
  padding: 8rpx 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.grid-item {
  width: 50%;
  padding: 0 10rpx 20rpx;
  box-sizing: border-box;
}
