# 生产模板：所有 CHANGE_ME/OWNER 值都会被启动校验拒绝，部署前必须替换。
MYSQL_ROOT_PASSWORD=CHANGE_ME_32_CHAR_ROOT_PASSWORD
MARKET_SHOP_DB_NAME=market_shop
MARKET_SHOP_DB_USER=market_shop
MARKET_SHOP_DB_PASSWORD=CHANGE_ME_32_CHAR_DATABASE_PASSWORD
MARKET_SHOP_REDIS_PASSWORD=CHANGE_ME_32_CHAR_REDIS_PASSWORD
MARKET_SHOP_REDIS_DATABASE=0
MARKET_SHOP_IMAGE=ghcr.io/OWNER/market-shop@sha256:CHANGE_ME_64_HEX_DIGEST
MARKET_SHOP_HTTP_BIND_HOST=127.0.0.1
MARKET_SHOP_HTTP_PORT=8080
SPRING_PROFILES_ACTIVE=prod
MARKET_SHOP_COOKIE_SECURE=true
# Optional separate storefront origin allow-list; comma-separated HTTPS origins only in prod.
MARKET_SHOP_ADDITIONAL_WRITE_ORIGINS=
MARKET_SHOP_SCHEDULING_ENABLED=true

# Outbox 重试：扫描毫秒、最大尝试、基础退避秒数、最大退避秒数。
MARKET_SHOP_JOBS_OUTBOX_DELAY_MS=5000
MARKET_SHOP_JOBS_OUTBOX_MAX_ATTEMPTS=5
MARKET_SHOP_JOBS_OUTBOX_BASE_DELAY_SECONDS=5
MARKET_SHOP_JOBS_OUTBOX_MAX_DELAY_SECONDS=3600

# 控制台日志：日志采集器不清理 ANSI 时使用 NEVER。
MARKET_SHOP_LOG_ANSI=NEVER
MARKET_SHOP_LOG_LEVEL=INFO
MARKET_SHOP_APP_LOG_LEVEL=INFO

# 默认使用持久卷中的本地私有对象；切换 s3 时生产端点必须是 HTTPS。
MARKET_SHOP_STORAGE_PROVIDER=local
# S3 后端来源：external 必须使用对象备份 hook；同一 Compose 项目的 RustFS 才能用 bundled。
MARKET_SHOP_S3_BACKEND_MODE=external
MARKET_SHOP_STORAGE_CREATE_BUCKET=false
MARKET_SHOP_LOCAL_STORAGE_ROOT=/opt/market-shop/data/uploads
MARKET_SHOP_LOCAL_STORAGE_SIGNING_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MARKET_SHOP_LOCAL_STORAGE_PRIVATE_BASE_URL=/api/v1/storage/private
MARKET_SHOP_SIGNED_URL_MINUTES=5
MARKET_SHOP_SIGNED_URL_SECONDS=0
MARKET_SHOP_OBJECT_STORAGE_HEALTH_TIMEOUT_SECONDS=4
MARKET_SHOP_OBJECT_STORAGE_API_TIMEOUT_SECONDS=15
MARKET_SHOP_RUSTFS_ENDPOINT=https://storage.example.invalid
MARKET_SHOP_RUSTFS_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MARKET_SHOP_RUSTFS_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MARKET_SHOP_RUSTFS_BUCKET=market-shop-private
MARKET_SHOP_RUSTFS_REGION=us-east-1
MARKET_SHOP_RUSTFS_BIND_HOST=127.0.0.1
MARKET_SHOP_RUSTFS_API_PORT=9000
MARKET_SHOP_RUSTFS_CONSOLE_PORT=9001

# 只允许空库首次启动时显式开启，完成后立即改回 false。
MARKET_SHOP_BOOTSTRAP_ADMIN_ENABLED=false
MARKET_SHOP_BOOTSTRAP_ADMIN_USERNAME=admin
MARKET_SHOP_BOOTSTRAP_ADMIN_PASSWORD=
MARKET_SHOP_BOOTSTRAP_INVITE_CODE=
# 首个真实微信账号认领发起人时手工输入；生产不得在文件中预填。
MARKET_SHOP_BOOTSTRAP_SPONSOR_CLAIM_SECRET=

MARKET_SHOP_WECHAT_ENABLED=false
MARKET_SHOP_WECHAT_MOCK_ENABLED=false
MARKET_SHOP_WECHAT_OA_APP_ID=
MARKET_SHOP_WECHAT_OA_SECRET=
MARKET_SHOP_WECHAT_WEB_APP_ID=
MARKET_SHOP_WECHAT_WEB_SECRET=
MARKET_SHOP_WECHAT_CALLBACK_BASE_URL=
MARKET_SHOP_STOREFRONT_BASE_URL=

# 运维脚本默认读取该文件；正式环境通常改为受限的 .env。
MARKET_SHOP_ENV_FILE=.env
MARKET_SHOP_BACKUP_ROOT=./backups
MARKET_SHOP_BACKUP_RETENTION_DAYS=14
MARKET_SHOP_CANDIDATE_PORT=18080
