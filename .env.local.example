# 仅供本机/CI 样本；必须与 docker-compose.local.yml 同时使用。
MYSQL_ROOT_PASSWORD=local_root_password_please_replace
MARKET_SHOP_DB_NAME=market_shop
MARKET_SHOP_DB_USER=market_shop
MARKET_SHOP_DB_PASSWORD=local_database_password_please_replace
MARKET_SHOP_DB_PORT=3308
MARKET_SHOP_REDIS_PASSWORD=local_redis_password_please_replace
MARKET_SHOP_REDIS_DATABASE=0
MARKET_SHOP_REDIS_PORT=6380
MARKET_SHOP_IMAGE=market-shop:local
MARKET_SHOP_HTTP_BIND_HOST=127.0.0.1
MARKET_SHOP_HTTP_PORT=8080
SPRING_PROFILES_ACTIVE=local
MARKET_SHOP_COOKIE_SECURE=false
# Vite storefront/admin dev origins accepted by the local write-origin guard.
MARKET_SHOP_ADDITIONAL_WRITE_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
MARKET_SHOP_SCHEDULING_ENABLED=true
MARKET_SHOP_JOBS_OUTBOX_DELAY_MS=5000
MARKET_SHOP_JOBS_OUTBOX_MAX_ATTEMPTS=5
MARKET_SHOP_JOBS_OUTBOX_BASE_DELAY_SECONDS=5
MARKET_SHOP_JOBS_OUTBOX_MAX_DELAY_SECONDS=3600
MARKET_SHOP_LOG_ANSI=ALWAYS
MARKET_SHOP_LOG_LEVEL=INFO
MARKET_SHOP_APP_LOG_LEVEL=INFO
MARKET_SHOP_STORAGE_PROVIDER=local
# 本地切换到 S3/RustFS 演示时可改为 s3；bundled 只适用于同一 Compose 项目内的 RustFS。
MARKET_SHOP_S3_BACKEND_MODE=bundled
MARKET_SHOP_STORAGE_CREATE_BUCKET=true
MARKET_SHOP_LOCAL_STORAGE_ROOT=/opt/market-shop/data/uploads
MARKET_SHOP_LOCAL_STORAGE_SIGNING_SECRET=local_signing_secret_with_more_than_32_chars
MARKET_SHOP_LOCAL_STORAGE_PRIVATE_BASE_URL=/api/v1/storage/private
MARKET_SHOP_SIGNED_URL_MINUTES=5
MARKET_SHOP_SIGNED_URL_SECONDS=0
MARKET_SHOP_OBJECT_STORAGE_HEALTH_TIMEOUT_SECONDS=4
MARKET_SHOP_OBJECT_STORAGE_API_TIMEOUT_SECONDS=15
MARKET_SHOP_RUSTFS_ENDPOINT=http://rustfs.localhost:9000
MARKET_SHOP_RUSTFS_ACCESS_KEY=marketshop-local
MARKET_SHOP_RUSTFS_SECRET_KEY=local_rustfs_secret_with_more_than_32_chars
MARKET_SHOP_RUSTFS_BUCKET=market-shop-private
MARKET_SHOP_RUSTFS_REGION=us-east-1
MARKET_SHOP_RUSTFS_BIND_HOST=127.0.0.1
MARKET_SHOP_RUSTFS_API_PORT=9000
MARKET_SHOP_RUSTFS_CONSOLE_PORT=9001
MARKET_SHOP_BOOTSTRAP_ADMIN_ENABLED=false
MARKET_SHOP_BOOTSTRAP_ADMIN_USERNAME=admin
MARKET_SHOP_BOOTSTRAP_ADMIN_PASSWORD=
MARKET_SHOP_BOOTSTRAP_INVITE_CODE=
# 仅本地/E2E 样本的强认领密钥，不用于生产。
MARKET_SHOP_BOOTSTRAP_SPONSOR_CLAIM_SECRET=LocalSponsorClaimSecret2026FixtureKey
MARKET_SHOP_WECHAT_ENABLED=false
MARKET_SHOP_WECHAT_MOCK_ENABLED=true
MARKET_SHOP_WECHAT_OA_APP_ID=
MARKET_SHOP_WECHAT_OA_SECRET=
MARKET_SHOP_WECHAT_WEB_APP_ID=
MARKET_SHOP_WECHAT_WEB_SECRET=
MARKET_SHOP_WECHAT_CALLBACK_BASE_URL=http://localhost:8080
MARKET_SHOP_STOREFRONT_BASE_URL=http://localhost:5173
